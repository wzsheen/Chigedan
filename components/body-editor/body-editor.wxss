.body-editor-mask{position:fixed;top:0;right:0;bottom:0;left:0;z-index:300;background:rgba(35,28,17,.30);display:flex;align-items:center;justify-content:center;padding:28rpx;box-sizing:border-box}.body-editor{box-sizing:border-box;width:100%;max-width:640rpx;max-height:90vh;overflow:auto;padding:30rpx;border-radius:30rpx;background:rgba(255,252,240,.94);border:1rpx solid rgba(255,255,255,.85);color:#64472b;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}.editor-title{display:block;font-size:32rpx;font-weight:600}.editor-date,.editor-hint{display:block;margin-top:10rpx;font-size:22rpx;color:#a18c72;line-height:1.7}.editor-fields{margin-top:20rpx}.editor-field{margin-top:16rpx}.editor-label{display:block;font-size:24rpx;margin-bottom:8rpx}.editor-input{display:flex;align-items:center;gap:16rpx;padding:12rpx 20rpx;border:1rpx solid rgba(190,167,120,.24);border-radius:18rpx;background:rgba(255,255,255,.6)}.editor-input input{flex:1;min-width:0;height:58rpx;font-size:29rpx;color:inherit}.editor-input>text{font-size:24rpx;color:#a18c72}.editor-error{display:block;color:#bd6255;font-size:23rpx;margin-top:16rpx;line-height:1.6}.editor-actions{display:flex;gap:22rpx;margin-top:28rpx}.editor-actions button{flex:1;min-width:0;margin:0;padding:16rpx 12rpx;font-size:26rpx;line-height:1.5;border-radius:18rpx;color:#805b36;background:#f1ebde}.editor-actions button:after{border:0}.editor-actions .editor-save{background:#ffdc69;color:#63451b}.body-editor-dark .body-editor{background:rgba(36,43,55,.96);border-color:#465061;color:#e5e5df}.body-editor-dark .editor-input{background:rgba(24,30,40,.58);border-color:#465061}.body-editor-dark .editor-actions button{background:#363e4b;color:#e5e5df}.body-editor-dark .editor-actions .editor-save{background:#d6b45e;color:#292415}

.editor-actions{display:block;font-size:0}.editor-action-slot{display:inline-block;vertical-align:top;box-sizing:border-box;width:47%}.editor-action-slot+.editor-action-slot{margin-left:6%}.editor-action-slot button{display:block;width:100%;margin:0;box-sizing:border-box}
