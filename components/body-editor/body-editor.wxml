<view wx:if="{{visible}}" class="body-editor-mask {{theme === 'dark' ? 'body-editor-dark' : ''}}" bindtap="close" catchtouchmove="noop"><view class="body-editor" catchtap="noop"><text class="editor-title">{{mode === 'weight' ? '记体重' : '记录身体数据'}}</text><text class="editor-date">今天 · {{date}}</text><text class="editor-hint" wx:if="{{mode !== 'weight'}}">只填写本次测量项，留空的项目不会记录。</text><view class="editor-fields"><view class="editor-field" wx:for="{{fields}}" wx:key="key"><text class="editor-label">{{item.label}}</text><view class="editor-input"><input type="digit" value="{{drafts[item.key]}}" data-key="{{item.key}}" bindinput="input" placeholder="{{'填写' + item.label}}" maxlength="7" adjust-position confirm-type="done" /><text>{{item.unit}}</text></view></view></view><text class="editor-error" wx:if="{{error}}">{{error}}</text><view class="editor-actions"><view class="editor-action-slot"><button bindtap="close" disabled="{{saving}}">取消</button></view><view class="editor-action-slot"><button class="editor-save" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存</button></view></view></view></view>
