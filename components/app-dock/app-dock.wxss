/* A single continuous vector skin replaces the three disconnected opaque surfaces. */

.liquid-neck{display:none;}
.action{border:none;background:transparent;box-shadow:none;backdrop-filter:none;-webkit-backdrop-filter:none;border-radius:50%;transition:transform .48s cubic-bezier(.2,.8,.2,1.12),opacity .18s;}
.is-open .action-manual{transform:translateY(-140rpx) rotate(0deg);}
.is-open .action-photo{transform:translateY(-266rpx) rotate(0deg);transition-delay:.045s;}
.is-open .fab{background:transparent;border-color:transparent;box-shadow:none;}
/* The recording bubble retains a curved fluid neck, independently of the menu surface. */


.liquid-surface{position:absolute;right:-16rpx;bottom:-16rpx;width:284rpx;height:408rpx;pointer-events:none;transform-origin:75% 83%;transform:scale(.16,.12);opacity:0;transition:transform .48s cubic-bezier(.18,.85,.26,1.13),opacity .22s;}
.is-open .liquid-surface{transform:scale(1);opacity:1;}

/* Voice: one continuous glass drop, including the microphone lobe. */
.recording-surface{position:absolute;right:-16rpx;bottom:-16rpx;width:360rpx;height:390rpx;pointer-events:none;background-image:url("data:image/svg+xml;base64,");background-size:100% 100%;background-repeat:no-repeat;opacity:0;transform:scale(.18,.16);transform-origin:80% 82%;transition:opacity .2s,transform .42s cubic-bezier(.2,.85,.25,1.12);}
.is-recording .recording-surface{opacity:1;transform:scale(1);animation:recording-flow 3.4s ease-in-out .42s infinite;}
.is-recording .listening{bottom:144rpx;width:320rpx;height:208rpx;padding:28rpx 24rpx 20rpx;background:transparent;border:none;box-shadow:none;border-radius:0;z-index:1;}
.is-recording .wave{height:82rpx;}
.is-recording .fab{background:transparent;border-color:transparent;box-shadow:none;}
.is-canceling .recording-surface{filter:hue-rotate(-18deg) saturate(.75);}
.is-canceling .listening{background:transparent;}
@keyframes recording-flow{0%,100%{transform:scale(1,1) rotate(0deg);}45%{transform:scale(1.018,.987) rotate(-.6deg);}75%{transform:scale(.99,1.012) rotate(.35deg);}}
.today-line-icon{display:block;width:52rpx;height:52rpx;margin:-7rpx 0;flex-shrink:0}
.today-line-icon{width:68rpx;height:68rpx;margin:-15rpx 0}
.fab .mic,.fab .mic-body,.fab .plus,.listening{pointer-events:none}.fab .mic[hidden],.fab .plus[hidden]{display:none}.is-canceling .recording-surface{filter:hue-rotate(325deg) saturate(.8)}
.pencil-icon{display:block;width:44rpx;height:44rpx;flex-shrink:0}

.home-float{bottom:calc(168rpx + env(safe-area-inset-bottom));right:36rpx}

/* Keep original nav geometry, with more visible frosted glass. */
.dock{background:rgba(255,253,245,.18);border-color:rgba(255,255,255,.65);backdrop-filter:blur(16px) saturate(145%);-webkit-backdrop-filter:blur(16px) saturate(145%);box-shadow:inset 0 2rpx 0 rgba(255,255,255,.72),inset 0 -1rpx 0 rgba(222,206,162,.16),0 10rpx 38rpx rgba(106,81,26,.08)}




.dock-dark{background:rgba(29,34,44,.30);border-color:rgba(255,255,255,.13);box-shadow:inset 0 2rpx 0 rgba(255,255,255,.09),0 10rpx 38rpx rgba(0,0,0,.24)}.dock-dark .tab{color:#a4adbc}.dock-dark .selected{color:#ffdc77}.float-dark .float-hint,.float-dark .action{background:rgba(35,41,53,.95);color:#eedcaf;border-color:#646051}.float-dark .camera{border-color:#d4bb80}.float-dark .camera:before{border-color:#d4bb80}

.is-open .action{right:26rpx;gap:12rpx;padding:0;line-height:1;box-shadow:none;background:transparent}.is-open .action-manual{transform:translateY(-151rpx)}.is-open .action-photo{transform:translateY(-280rpx)}

/* Highlights follow the existing continuous liquid shape. */
.liquid-surface{background-image:url("data:image/svg+xml;base64,");background-size:100% 100%;background-repeat:no-repeat;filter:drop-shadow(0 8rpx 11rpx rgba(186,128,5,.42)) drop-shadow(0 20rpx 28rpx rgba(186,128,5,.26));}
.is-open .action{text-shadow:0 1rpx 0 rgba(255,255,255,.7)}
.is-open .fab{background:radial-gradient(circle at 33% 24%,rgba(255,255,255,.36),rgba(255,255,255,0) 65%)}
.float-dark.is-open .action{color:#59401f}
.float-dark.is-open .camera,.float-dark.is-open .camera:before{border-color:#795929}

/* Stretch from the add button, overshoot slightly, then settle. */
.is-open .liquid-surface {
    animation: dock-menu-stretch .46s ease-out both;
}
.is-recording .recording-surface {
    animation: dock-voice-stretch .44s ease-out both, recording-flow 3.4s ease-in-out .44s infinite;
}
.is-recording .listening {
    animation: dock-voice-reveal .24s ease-out .12s both;
}
@keyframes dock-menu-stretch {
    0% { transform: scale(.34,.24); opacity: 0; }
    40% { transform: scale(.72,1.06); opacity: 1; }
    72% { transform: scale(1.025,.98); }
    100% { transform: scale(1); opacity: 1; }
}
@keyframes dock-voice-stretch {
    0% { transform: scale(.3,.26); opacity: 0; }
    42% { transform: scale(.8,1.055); opacity: 1; }
    74% { transform: scale(1.025,.985); }
    100% { transform: scale(1); opacity: 1; }
}
@keyframes dock-voice-reveal {
    from { transform: translateY(12rpx); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}
@media (prefers-reduced-motion: reduce) {
    .float .liquid-surface,.float .recording-surface,.float .action,.float .listening {
        animation: none;
        transition: none;
    }
}

/* 深色主题下投影用冷黑，避免黄色投影发脏 */
.float-dark .liquid-surface{filter:drop-shadow(0 8rpx 12rpx rgba(58,34,0,.5)) drop-shadow(0 22rpx 30rpx rgba(38,22,0,.34));}

