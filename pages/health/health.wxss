.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 32rpx 32rpx 120rpx;
}

.header {
    margin-bottom: 20rpx;
}

.page-title {
    display: block;
    color: #432b1d;
    font-size: 40rpx;
    font-weight: 600;
}

.page-sub {
    display: block;
    margin-top: 6rpx;
    color: #a29180;
    font-size: 24rpx;
}

/* 档案封面：编号 + 概览 + BMI，像一张证件 */
.archive {
    padding: 30rpx 30rpx 26rpx;
    border-radius: 28rpx;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(14rpx);
    -webkit-backdrop-filter: blur(14rpx);
    border: 2rpx solid rgba(255, 255, 255, 0.72);
    box-shadow: 0 16rpx 48rpx rgba(100, 68, 22, 0.07);
}

.archive-top {
    display: flex;
    align-items: center;
}

.stamp {
    flex: 0 0 auto;
    width: 96rpx;
    height: 96rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: linear-gradient(135deg, #ff9a6b, #a76b11);
    box-shadow: 0 8rpx 22rpx rgba(230, 174, 26, 0.32), inset 0 2rpx 6rpx rgba(255, 255, 255, 0.4);
}

.stamp-text {
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 600;
    letter-spacing: 2rpx;
}

.archive-id {
    flex: 1;
    min-width: 0;
    margin-left: 22rpx;
}

.name-line {
    display: flex;
    align-items: center;
}

.archive-name {
    max-width: 360rpx;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: #432b1d;
    font-size: 38rpx;
    font-weight: 600;
}

.readonly-tag {
    margin-left: 14rpx;
    padding: 2rpx 12rpx;
    border-radius: 8rpx;
    background: rgba(100, 68, 22, 0.06);
    color: #a29180;
    font-size: 20rpx;
    line-height: 1.6;
}

.archive-line {
    display: block;
    margin-top: 8rpx;
    color: #86725e;
    font-size: 24rpx;
}

.archive-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: 26rpx;
    padding-top: 24rpx;
    border-top: 2rpx solid rgba(100, 68, 22, 0.06);
}

.archive-no {
    flex: 1;
    min-width: 0;
}

.no-label {
    display: block;
    color: #a29180;
    font-size: 21rpx;
}

.no-value {
    display: block;
    margin-top: 4rpx;
    color: #432b1d;
    font-size: 28rpx;
    font-weight: 600;
    letter-spacing: 1rpx;
}

.no-date {
    display: block;
    margin-top: 6rpx;
    color: #a6abb3;
    font-size: 20rpx;
}

.archive-bmi {
    flex: 0 0 auto;
    margin-left: 20rpx;
    text-align: right;
}

.bmi-value {
    display: block;
    color: #d9531e;
    font-size: 52rpx;
    font-weight: 600;
    line-height: 1.1;
}

.bmi-label {
    display: block;
    margin-top: 2rpx;
    color: #b2663a;
    font-size: 21rpx;
}

/* 只读信息行 */
.group-title {
    display: block;
    margin: 32rpx 8rpx 12rpx;
    color: #a29180;
    font-size: 22rpx;
}

.group {
    border-radius: 24rpx;
    background: rgba(255, 255, 255, 0.62);
    backdrop-filter: blur(14rpx);
    -webkit-backdrop-filter: blur(14rpx);
    border: 2rpx solid rgba(255, 255, 255, 0.6);
    box-shadow: 0 12rpx 36rpx rgba(100, 68, 22, 0.05);
    overflow: hidden;
}

.line {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 96rpx;
    padding: 18rpx 26rpx;
    box-sizing: border-box;
}

.line::after {
    content: '';
    position: absolute;
    left: 26rpx;
    right: 26rpx;
    bottom: 0;
    height: 2rpx;
    background: rgba(100, 68, 22, 0.05);
}

.line-last::after {
    display: none;
}

.line-label {
    flex: 0 0 auto;
    margin-right: 28rpx;
    color: #a29180;
    font-size: 25rpx;
}

.line-value {
    flex: 1;
    text-align: right;
    color: #432b1d;
    font-size: 27rpx;
    font-weight: 600;
    line-height: 1.45;
    word-break: break-all;
}

/* 只读说明 */
.notice {
    margin-top: 30rpx;
    padding: 24rpx 26rpx;
    border-radius: 22rpx;
    background: rgba(255, 255, 255, 0.45);
    border: 2rpx dashed rgba(100, 68, 22, 0.14);
}

.notice-tag {
    display: inline-block;
    margin-bottom: 12rpx;
    padding: 3rpx 14rpx;
    border-radius: 8rpx;
    background: rgba(100, 68, 22, 0.06);
    color: #a29180;
    font-size: 20rpx;
}

.notice-text {
    display: block;
    color: #a29180;
    font-size: 22rpx;
    line-height: 1.7;
}

.notice-text + .notice-text {
    margin-top: 8rpx;
}

.actions {
    margin-top: 44rpx;
}

.action-button {
    width: 100%;
    border-radius: 16rpx;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(20rpx);
    -webkit-backdrop-filter: blur(20rpx);
    border: 2rpx solid rgba(255, 255, 255, 0.7);
    color: #432b1d;
    font-size: 30rpx;
}

.action-primary {
    background: linear-gradient(135deg, #ffd555, #a76b11);
    color: #ffffff;
    border: none;
    box-shadow: 0 8rpx 24rpx rgba(230, 174, 26, 0.35);
}

.action-hint {
    display: block;
    margin-top: 18rpx;
    color: #a29180;
    font-size: 22rpx;
    text-align: center;
    line-height: 1.6;
}

.fallback {
    width: 100%;
    margin-top: 18rpx;
    padding: 20rpx;
    box-sizing: border-box;
    border-radius: 16rpx;
    background: rgba(255, 255, 255, 0.7);
    border: 2rpx solid rgba(100, 68, 22, 0.08);
    color: #86725e;
    font-size: 22rpx;
    line-height: 1.6;
}

/* 绘图用画布：移出视口，不参与布局，也不遮挡内容 */
.archive-canvas {
    position: fixed;
    left: -3000rpx;
    top: 0;
    width: 1085rpx;
    height: 1535rpx;
    pointer-events: none;
}

@import "../../styles/cream.wxss";

@import "../../styles/surfaces.wxss";
