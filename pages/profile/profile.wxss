@import "../../styles/cream.wxss";
.page.profile-page{box-sizing:border-box;min-height:100vh;padding:26rpx 28rpx calc(190rpx + env(safe-area-inset-bottom));color:#503723}.profile-page .header{margin:5rpx 6rpx 22rpx}.profile-page .header .page-sub{display:block;margin:0;font-size:26rpx;line-height:1.7;color:#674c33}
.profile-page .profile-card{padding:24rpx;border-radius:32rpx;background:rgba(255,254,248,.46);border:1rpx solid rgba(255,255,255,.94);box-shadow:inset 0 1rpx 0 #fff,0 7rpx 24rpx rgba(128,95,30,.025)}.profile-top{display:flex;align-items:center}.avatar-wrap{position:relative;width:122rpx;height:122rpx;flex:none;margin-right:22rpx}.avatar-img,.avatar-toy,.avatar-toy-image{display:block;width:122rpx;height:122rpx;border-radius:50%}.avatar-toy{background:rgba(255,236,170,.48)}.avatar-hover{opacity:.85}.avatar-edit{position:absolute;right:0;bottom:0;width:31rpx;height:31rpx;line-height:31rpx;text-align:center;background:#ffda70;border:2rpx solid #fff;border-radius:50%;font-size:17rpx;color:#8f6b24}.profile-meta{flex:1;min-width:0}.name-row{display:flex;align-items:center;margin-bottom:18rpx}.name-text{max-width:350rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:32rpx;font-weight:600}.name-pencil{width:27rpx;height:27rpx;margin-left:12rpx;opacity:.65}.name-editor{display:flex;align-items:center;margin-bottom:12rpx}.name-input{flex:1;width:0;min-width:0;height:62rpx;padding:0 12rpx;box-sizing:border-box;border-radius:15rpx;background:rgba(255,255,255,.8);border:1rpx solid #e5d6b2;font-size:25rpx}.name-action{flex:none;margin-left:15rpx;font-size:23rpx;color:#9b772e}.name-action-cancel{color:#b19c7f}.name-error{display:block;font-size:21rpx;color:#b65a40;margin:8rpx 0}.metric-row{display:flex;align-items:center}.metric{width:33.33%;display:flex;flex-direction:column;align-items:center;text-align:center;border-right:1rpx solid #eae0cd;box-sizing:border-box}.metric:last-child{border-right:0}.metric>view{white-space:nowrap}.metric-value{font-size:29rpx;font-weight:600}.metric-unit{font-size:18rpx;margin-left:4rpx;color:#a28c70}.metric-label{display:block;font-size:20rpx;color:#aa957a;margin-top:8rpx}
.profile-group{margin-top:22rpx;padding:22rpx 22rpx 16rpx;border-radius:30rpx;border:1rpx solid rgba(255,255,255,.93);background:rgba(255,254,248,.45);box-shadow:inset 0 1rpx 0 #fff,0 7rpx 24rpx rgba(128,95,30,.02)}.profile-group-title{display:block;font-size:27rpx;font-weight:600;margin:0 5rpx 15rpx}.profile-grid{display:flex;flex-wrap:wrap;justify-content:space-between}.profile-menu{box-sizing:border-box;width:49%;min-height:78rpx;display:flex;align-items:center;padding:10rpx 8rpx;margin-bottom:8rpx;background:rgba(255,255,255,.24);border-radius:18rpx}.profile-menu.menu-wide{width:100%}.profile-menu>text{font-size:25rpx;white-space:nowrap}.profile-menu-icon{flex:none;width:48rpx;height:48rpx;background:rgba(255,233,158,.45);border:1rpx solid rgba(255,255,255,.8);border-radius:15rpx;display:flex;align-items:center;justify-content:center;margin-right:12rpx}.profile-menu-icon image{width:35rpx;height:35rpx}.profile-menu .menu-chevron{margin-left:auto;padding:0 5rpx 0 8rpx;color:#ad997d;font-size:29rpx}.profile-menu-hover{background:rgba(255,233,158,.35)}.local-data-note{display:block;text-align:center;color:#9f8a6d;font-size:21rpx;line-height:1.7;margin:24rpx 0 0;padding:6rpx}.avatar-cell .avatar-toy,.avatar-cell .avatar-toy-image{width:108rpx;height:108rpx}
.avatar-source {
    display: flex;
    align-items: center;
    margin-top: 22rpx;
}

.avatar-source-btn {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 104rpx;
    border-radius: 22rpx;
    background: rgba(230, 174, 26, 0.1);
    border: 2rpx dashed rgba(230, 174, 26, 0.45);
}

.avatar-source-hover {
    background: rgba(230, 174, 26, 0.18);
}

.avatar-source-main {
    color: #a76b11;
    font-size: 28rpx;
    font-weight: 600;
}

.avatar-source-hint {
    margin-top: 6rpx;
    color: #c2511d;
    font-size: 20rpx;
}

.avatar-source-reset {
    display: flex;
    align-items: center;
    height: 104rpx;
    margin-left: 20rpx;
    padding: 0 26rpx;
    border-radius: 22rpx;
    background: rgba(100, 68, 22, 0.05);
    color: #86725e;
    font-size: 24rpx;
}



.avatar-mask {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: flex-end;
    background: rgba(20, 22, 26, 0.3);
    backdrop-filter: blur(8rpx);
    -webkit-backdrop-filter: blur(8rpx);
    z-index: 200;
}

.avatar-sheet {
    width: 100%;
    padding: 34rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
    box-sizing: border-box;
    border-radius: 36rpx 36rpx 0 0;
    background: rgba(255, 251, 247, 0.97);
    border-top: 2rpx solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 -12rpx 40rpx rgba(100, 68, 22, 0.12);
}

.sheet-head {
    display: flex;
    flex-direction: column;
}

.sheet-title {
    color: #432b1d;
    font-size: 32rpx;
    font-weight: 600;
}

.sheet-sub {
    margin-top: 6rpx;
    color: #a29180;
    font-size: 22rpx;
}

.avatar-grid {
    display: flex;
    flex-wrap: wrap;
    margin-top: 22rpx;
}

.avatar-cell {
    width: 25%;
    padding: 14rpx 0 12rpx;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    border-radius: 24rpx;
}

.avatar-cell-active {
    background: rgba(230, 174, 26, 0.1);
    box-shadow: inset 0 0 0 2rpx rgba(230, 174, 26, 0.38);
}

.avatar-name {
    margin-top: 8rpx;
    color: #86725e;
    font-size: 20rpx;
}

.avatar-cell-active .avatar-name {
    color: #a76b11;
    font-weight: 600;
}

.sheet-close {
    margin-top: 18rpx;
    height: 88rpx;
    border-radius: 999rpx;
    background: rgba(100, 68, 22, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #86725e;
    font-size: 28rpx;
}

.pop-mask {
    position: fixed;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    background: rgba(100, 68, 22, 0.16);
    animation: popMaskIn 0.16s ease-out;
}

.mini-pop {
    position: fixed;
    left: 50%;
    z-index: 41;
    width: 520rpx;
    margin-left: -260rpx;
    padding: 30rpx 30rpx 26rpx;
    box-sizing: border-box;
    border-radius: 28rpx;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(30rpx);
    -webkit-backdrop-filter: blur(30rpx);
    border: 2rpx solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 20rpx 60rpx rgba(100, 68, 22, 0.18);
    animation: popIn 0.18s ease-out;
}

.pop-head {
    display: flex;
    flex-direction: column;
}

.pop-title {
    color: #432b1d;
    font-size: 30rpx;
    font-weight: 600;
}

.pop-sub {
    margin-top: 6rpx;
    color: #a29180;
    font-size: 22rpx;
}

.pop-input-row {
    display: flex;
    align-items: center;
    height: 88rpx;
    margin-top: 20rpx;
    padding: 0 24rpx;
    box-sizing: border-box;
    border-radius: 18rpx;
    background: rgba(230, 174, 26, 0.06);
    border: 2rpx solid rgba(230, 174, 26, 0.22);
}

.pop-input {
    flex: 1;
    min-width: 0;
    height: 88rpx;
    line-height: 88rpx;
    color: #432b1d;
    font-size: 32rpx;
    font-weight: 600;
}

.pop-unit {
    margin-left: 12rpx;
    color: #a29180;
    font-size: 26rpx;
}

.pop-error {
    display: block;
    margin-top: 12rpx;
    color: #e24b4a;
    font-size: 22rpx;
}

.pop-desc {
    display: block;
    margin-top: 18rpx;
    color: #86725e;
    font-size: 24rpx;
    line-height: 1.6;
}

.pop-actions {
    display: flex;
    margin-top: 26rpx;
}

.pop-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 76rpx;
    border-radius: 18rpx;
    font-size: 27rpx;
}

.pop-btn-ghost {
    margin-right: 16rpx;
    color: #86725e;
    background: rgba(100, 68, 22, 0.05);
}

.pop-btn-primary {
    color: #ffffff;
    font-weight: 600;
    background: linear-gradient(135deg, #ffd555, #a76b11);
    box-shadow: 0 8rpx 20rpx rgba(230, 174, 26, 0.3);
}

.pop-btn-hover {
    opacity: 0.7;
}

.pop-btn-primary-hover {
    opacity: 0.86;
}

@keyframes popMaskIn {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

@keyframes popIn {
    from {
        opacity: 0;
        transform: translateY(10rpx) scale(0.94);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}


.page .pop-actions{gap:0}.page .pop-actions .pop-btn{box-sizing:border-box;min-width:0;flex:1 1 0;margin:0}.page .pop-actions .pop-action-space{flex:0 0 24rpx;width:24rpx}

@import "../../styles/surfaces.wxss";
