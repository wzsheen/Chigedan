.body-trend-tabs{display:flex;gap:10rpx;margin-top:18rpx}.body-trend-tabs>view{padding:9rpx 22rpx;border-radius:18rpx;font-size:22rpx;color:#a18c6a;background:rgba(204,185,139,.10)}.body-trend-tabs>.body-trend-active{background:rgba(255,222,120,.38);color:#8d6a25}.ui-theme-dark .body-trend-tabs>.body-trend-active{background:rgba(221,184,88,.18);color:#e2c27b}.ui-theme-dark .ring-unit,.ui-theme-dark .ring-label{color:#a9b3c4}

