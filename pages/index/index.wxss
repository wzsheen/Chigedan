page{background:#fffbf2;background-image:radial-gradient(ellipse at 95% 5%,rgba(255,228,133,.12),transparent 65%)}
.page{box-sizing:border-box;min-height:100vh;padding:24rpx 28rpx calc(300rpx + env(safe-area-inset-bottom));color:#593524}
.brand-header{display:flex;align-items:center;min-height:48rpx;margin:0 4rpx 22rpx}
.brand-slogan{display:block;width:440rpx;height:48rpx;max-width:100%}
.energy-card,.science-card,.body-card,.meals-card,.water-card{box-sizing:border-box;border-radius:34rpx;border:1rpx solid rgba(255,255,255,.9);background:rgba(255,255,255,.90);box-shadow:0 5rpx 20rpx rgba(122,85,29,.025)}
.energy-card{padding:24rpx 28rpx 20rpx;background:linear-gradient(125deg,#fff8df,#fffbed);transition:background .35s ease}
.card-top{display:flex;align-items:center;min-height:30rpx}
.today-title,.date{font-size:22rpx;line-height:1.4;font-weight:400;color:#495337}.date{margin-left:4rpx}
.energy-overview{position:relative;min-height:210rpx}
.goal-reminder-bubble{position:absolute;z-index:3;right:0;top:-34rpx;max-width:390rpx;padding:8rpx 16rpx;border:1rpx solid #efd78f;border-radius:18rpx;background:#fffaf0;color:#674821;font-size:21rpx;line-height:1.4;text-align:center;pointer-events:none;box-shadow:0 3rpx 12rpx rgba(110,75,20,.1)}
.ui-theme-dark .goal-reminder-bubble{background:#3b3528;border-color:#7c6b43;color:#ffe7a3}
.energy-copy{position:relative;width:calc(100% - 232rpx);padding-top:10rpx;z-index:1}
.energy-display{display:flex;align-items:flex-end;min-width:0;height:112rpx}
.energy-digits{display:flex;align-items:flex-end;gap:4rpx;height:112rpx;max-width:350rpx;min-width:0;flex-shrink:1}
.energy-digit{display:block;width:58rpx;height:112rpx;flex-shrink:1;min-width:0}.energy-dot{width:12rpx}
.energy-unit{font-size:28rpx;line-height:1.3;margin-left:10rpx;padding-bottom:7rpx;flex-shrink:0}
.energy-meta{display:flex;align-items:center;gap:12rpx;margin-top:16rpx;min-height:36rpx;font-size:22rpx;line-height:1.5;white-space:nowrap;width:max-content;max-width:100%}
.meta-divider{color:#d0c9ad}.over{color:#c4674f}
.hero-mascot{position:absolute;right:-8rpx;top:-30rpx;width:258rpx;height:258rpx;pointer-events:none}
.hero-mascot egg-mascot{position:absolute;top:0;right:0;transform:scale(1.65);transform-origin:100% 0}
.mascot-rays{position:absolute;right:2rpx;top:14rpx;width:42rpx;height:50rpx;transform:rotate(17deg)}
.mascot-rays view{position:absolute;width:9rpx;height:25rpx;background:#ffd221;border-radius:8rpx;left:0;top:0;transform:rotate(10deg)}
.mascot-rays view:nth-child(2){left:19rpx;top:8rpx;transform:rotate(35deg)}.mascot-rays view:nth-child(3){left:30rpx;top:28rpx;height:19rpx;transform:rotate(65deg)}
.macros{display:flex;margin-top:16rpx;padding:0;border:0}
.macro{flex:1;min-width:0;padding:0 18rpx;border-left:1rpx solid rgba(169,178,134,.21)}
.macro:first-child{border:0;padding-left:0}.macro:last-child{padding-right:0}
.macro-name{font-size:22rpx;line-height:1.4;color:#513d2a}
.macro-value{margin-top:4rpx;font-size:22rpx;font-weight:600;line-height:1.4;white-space:nowrap}.macro-value text{font-size:19rpx;font-weight:400}
.macro-track{height:19rpx;margin-top:8rpx;border-radius:14rpx;background:rgba(198,208,164,.35);overflow:hidden}
.macro-track view{height:100%;border-radius:14rpx;transition:width .3s ease}
.macro-protein .macro-track view{background:linear-gradient(90deg,#ffd900,#ffdf38)}
.macro-carb .macro-track view{background:linear-gradient(90deg,#77d437,#a6e669)}
.macro-fat .macro-track view{background:linear-gradient(90deg,#ff6a60,#ff9383)}
.diet-message{display:flex;align-items:center;justify-content:center;gap:12rpx;min-height:60rpx;margin-top:18rpx;padding:10rpx 16rpx;box-sizing:border-box;background:rgba(240,221,165,.22);border-radius:32rpx}
.energy-good .diet-message{background:rgba(195,225,137,.25)}.energy-adjust .diet-message{background:rgba(224,145,114,.15)}
.diet-leaf{display:block;width:30rpx;height:30rpx;flex-shrink:0}
.diet-dot{display:flex;align-items:center;justify-content:center;width:28rpx;height:28rpx;border-radius:50%;background:#e5bb57;color:#fff;font-size:21rpx;flex-shrink:0}
.energy-adjust .diet-dot{background:#d68c73}
.diet-title{font-size:23rpx;line-height:1.5;color:#6e5938;min-width:0}.energy-good .diet-title{color:#526f2a}.energy-adjust .diet-title{color:#a15e46}
.diet-action{margin-left:auto;font-size:30rpx;color:#ac7450;flex-shrink:0}
.science-card{display:flex;align-items:center;gap:18rpx;margin-top:16rpx;padding:12rpx 22rpx;min-height:116rpx}
.science-book,.card-icon{display:flex;align-items:center;justify-content:center;width:68rpx;height:68rpx;flex-shrink:0;border-radius:21rpx}
.science-book{background:#fff4c7}.science-line-icon{display:block;width:94rpx;height:94rpx;flex-shrink:0}
.science-swiper{flex:1;min-width:0;height:88rpx}.science-item{height:88rpx;display:flex;flex-direction:column;justify-content:center;gap:6rpx}
.science-label,.body-header,.section-head,.water-title{font-size:24rpx;line-height:1.4;color:#6b412b;font-weight:500}
.science-title{font-size:20rpx;line-height:1.5;font-weight:400;color:#80604d;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.science-more,.card-chevron{font-size:36rpx;font-weight:400;line-height:1;color:#b5a28d;flex-shrink:0}
.science-more{padding:16rpx 0 16rpx 10rpx}
.body-card{position:relative;display:flex;align-items:center;gap:18rpx;margin-top:16rpx;min-height:140rpx;padding:18rpx 22rpx}
.body-icon{background:#efffe9}.card-icon image{display:block;width:68rpx;height:68rpx;flex-shrink:0}
.body-content{flex:1;min-width:0}.body-header{margin-bottom:8rpx}
.body-metrics{display:flex;align-items:stretch}.body-metric{box-sizing:border-box;flex:1 1 0;width:0;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:3rpx;border-left:1rpx solid #f0e6dd}
.body-metric:first-child{border-left-color:transparent}.body-value{font-size:32rpx;font-weight:600;line-height:1.25;white-space:nowrap;color:#673928}
.body-unit{font-size:20rpx;font-weight:400}.body-label{font-size:18rpx;line-height:1.4;color:#a69c8e}
.body-card .metric-low{color:#4b91ad}.body-card .metric-normal{color:#18b329}.body-card .metric-high{color:#c49c19}.body-card .metric-danger{color:#d04a43}
.body-card>.card-chevron{position:absolute;right:22rpx;top:23rpx}
.body-flash{animation:body-flash 1.5s ease-out}@keyframes body-flash{from{box-shadow:0 0 0 4rpx rgba(239,201,90,.3)}to{box-shadow:0 5rpx 20rpx rgba(122,85,29,.025)}}
.meals-card{margin-top:16rpx;padding:16rpx 22rpx 8rpx}
.section-head{display:flex;align-items:center;gap:18rpx;min-height:42rpx}.section-head .card-chevron{margin-left:auto}
.meals-icon{background:#fff5da;width:54rpx;height:54rpx;border-radius:17rpx}.meals-icon image{width:54rpx;height:54rpx}
.meal-block{position:relative;border-bottom:0}.meal-block:after{content:"";position:absolute;left:144rpx;right:8rpx;bottom:0;height:1rpx;pointer-events:none;background:linear-gradient(90deg,rgba(139,112,76,.10),rgba(139,112,76,.035))}.meal-block:last-child:after{display:none}
.meal-row{display:flex;align-items:center;min-height:94rpx;padding:6rpx 0;box-sizing:border-box}
.meal-art{width:144rpx;height:82rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center}
.meal-line-icon{display:block;width:94rpx;height:94rpx;flex-shrink:0}
.meal-copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:5rpx}
.meal-title{font-size:26rpx;line-height:1.3;color:#5d3829}.meal-summary{font-size:21rpx;line-height:1.4;color:#a09385;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.meal-energy{margin-left:12rpx;color:#633b2b;white-space:nowrap;flex-shrink:0}
.meal-energy-value{font-size:34rpx;font-weight:600}.meal-energy-unit{font-size:21rpx}.meal-pending{font-size:22rpx;color:#a59483}
.egg-white{display:flex;align-items:center;justify-content:center;width:50rpx;height:44rpx;border-radius:50%;background:#fff9e5;transform:rotate(-12deg)}.egg-yolk{width:27rpx;height:27rpx;border-radius:50%;background:#ffc933}
.meal-detail{padding:0 4rpx 12rpx 20rpx}.record-row{display:flex;align-items:center;padding:12rpx 0;border-bottom:1rpx solid #f4edde;font-size:24rpx}.record-copy{flex:1;min-width:0;display:flex;flex-direction:column}.record-note{font-size:20rpx;color:#a79680;margin-top:6rpx}.record-energy{font-size:22rpx;margin-left:12rpx}.delete{font-size:21rpx;color:#ac9b86;padding:20rpx 8rpx 20rpx 20rpx}.delete-pending{color:#b85b3e}.add-meal{box-sizing:border-box;width:max-content;max-width:100%;margin:12rpx 0 4rpx auto;padding:10rpx 16rpx;border-radius:14rpx;background:rgba(255,220,100,.42);border:1rpx solid rgba(218,171,47,.25);font-size:21rpx;font-weight:500;line-height:1.35;color:#805b16;text-align:center}
.record-name{display:flex;min-width:0;white-space:nowrap}.record-name-text{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.record-qty{flex:none}.record-side{display:flex;flex:none;flex-direction:column;align-items:center;justify-content:center;gap:6rpx;margin-left:10rpx}.record-side .record-energy{margin-left:0;white-space:nowrap}.record-source{box-sizing:border-box;padding:3rpx 8rpx;border-radius:8rpx;font-size:18rpx;line-height:1.3;white-space:nowrap}.record-source-library{color:#557b48;background:rgba(123,176,100,.18)}.record-source-ai{color:#9b691c;background:rgba(240,187,69,.25)}.record-note{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ui-theme-dark .record-source-library{color:#c0dea9;background:rgba(125,177,100,.22)}.ui-theme-dark .record-source-ai{color:#f0ce83;background:rgba(221,174,67,.23)}
.record-side{margin-right:16rpx}
.water-card{position:relative;display:flex;align-items:center;flex-wrap:wrap;gap:16rpx;padding:20rpx 22rpx;margin-top:16rpx}
/* 打开目标弹窗的热区跟着「1200 / 2000 ml ▾」这段文字走，边界就是字尾（红线处），右侧 ＋水 按钮不在其中 */
.water-amount{position:relative}
.water-amount::after{content:'';position:absolute;left:-14rpx;right:-10rpx;top:-16rpx;bottom:-32rpx}
.water-symbol{width:68rpx;height:68rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.water-line-icon{width:94rpx;height:94rpx;display:block;flex-shrink:0}
.water-copy{flex:1;min-width:0}.water-title{display:inline-block;margin-bottom:5rpx}.water-number{font-size:30rpx;font-weight:600}.water-target{font-size:21rpx;color:#9a8772}
.water-track{height:10rpx;margin-top:10rpx;border-radius:9rpx;background:#f0eee6;overflow:hidden}.water-track view{height:100%;background:linear-gradient(90deg,#a4d2f4,#74b8ee);border-radius:9rpx}
.water-statline{display:flex;align-items:center;justify-content:space-between;gap:10rpx}.water-amount{flex:none;white-space:nowrap}.water-quick{display:flex;flex:1;min-width:0;justify-content:flex-end;gap:8rpx;margin:0 0 0 6rpx;transform:translateY(-18rpx)}.water-add{box-sizing:border-box;flex:1;min-width:0;max-width:100rpx;padding:7rpx 3rpx;text-align:center;border-radius:12rpx;font-size:18rpx;line-height:26rpx;white-space:nowrap;color:#6b9bb9;background:rgba(236,246,252,.8);position:relative;z-index:3}
.insight{display:flex;align-items:center;gap:18rpx;margin:20rpx 6rpx 0;padding:8rpx}.insight-icon{height:60rpx;width:60rpx;background:#fff3cb;border-radius:18rpx;display:flex;align-items:center;justify-content:center;color:#b3872b;font-size:32rpx}.insight-copy{flex:1;display:flex;flex-direction:column;gap:7rpx}.insight-title{font-size:24rpx;color:#846744}.insight-sub{font-size:21rpx;color:#b09d82}.chevron{color:#a89074;font-size:33rpx}
.state-card{padding:60rpx 28rpx;background:#fffdf6;border-radius:30rpx;display:flex;flex-direction:column;align-items:center;gap:20rpx;color:#8e7557;font-size:26rpx}.muted{font-size:23rpx;color:#ac9980}
@media(max-width:340px){.energy-meta{gap:8rpx;font-size:21rpx}.macro{padding-left:12rpx;padding-right:12rpx}.meal-art{width:112rpx}.meal-energy-value{font-size:30rpx}.body-value{font-size:29rpx}}

.goal-number{font-weight:600;font-size:28rpx}.meta-unit{font-size:21rpx}

@import "../../styles/surfaces.wxss";

.ui-theme-dark .add-meal{background:rgba(255,209,78,.18);border-color:rgba(255,218,111,.32);color:#ffdc77}

.ui-theme-dark .meal-block:after{background:linear-gradient(90deg,rgba(219,226,236,.09),rgba(219,226,236,.015))}
@media(max-width:340px){.meal-block:after{left:112rpx}}

.ui-theme-dark .energy-card{border-color:transparent;box-shadow:0 8rpx 24rpx rgba(0,0,0,.09)}

.entry-guide{position:fixed;inset:0;z-index:1000;overflow:hidden}
.entry-guide-spot{position:absolute;box-sizing:border-box;border:2px solid #ffdb73;border-radius:16rpx;box-shadow:0 0 0 3000px rgba(23,24,28,.65);pointer-events:none}
.entry-guide-round{border-radius:50%}
.entry-guide-tip{position:absolute;left:28rpx;right:28rpx;box-sizing:border-box;padding:26rpx 28rpx;border:1rpx solid #fff;border-radius:26rpx;background:#fffaf0;color:#503723;box-shadow:0 12rpx 40rpx rgba(0,0,0,.15);max-height:calc(100vh - 32px);overflow-y:auto}
.entry-guide-progress{display:block;color:#a18a62;font-size:22rpx;line-height:1.5}
.entry-guide-title{display:block;font-size:30rpx;font-weight:600;line-height:1.6;margin-top:8rpx}
.entry-guide-copy{display:block;font-size:25rpx;line-height:1.85;color:#8d785f;margin-top:14rpx}
.entry-guide-actions{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:22rpx}
.entry-guide-actions button{margin:0;font-size:24rpx;line-height:1.6;padding:16rpx 20rpx;border-radius:18rpx;text-align:center}
.entry-guide-actions button::after{border:0}.entry-guide-skip{background:transparent;color:#8d785f;flex:none}.entry-guide-next{background:#ffda68;color:#503312;font-weight:600;flex:1}.entry-guide-error{display:block;color:#a44f39;font-size:23rpx;line-height:1.6;margin-top:10rpx}
.ui-theme-light .entry-guide-tip{background:#fff7df}.ui-theme-dark .entry-guide-tip{background:#262b34;border-color:#465061;color:#e5e5df}.ui-theme-dark .entry-guide-copy,.ui-theme-dark .entry-guide-progress,.ui-theme-dark .entry-guide-skip{color:#b5becc}.ui-theme-dark .entry-guide-next{background:#dbbc68;color:#292314}.ui-theme-dark .entry-guide-error{color:#f4938c}

.water-goal-mask{position:fixed;inset:0;z-index:900;display:flex;align-items:center;justify-content:center;padding:32rpx;background:rgba(30,28,24,.45);box-sizing:border-box}
.water-goal-dialog{box-sizing:border-box;width:100%;max-width:650rpx;max-height:80vh;overflow-y:auto;border:1rpx solid #fff;border-radius:28rpx;padding:30rpx;background:#fffaf0;color:#503723}
.water-goal-title{display:block;font-size:31rpx;font-weight:600;line-height:1.6}.water-goal-note{display:block;font-size:23rpx;color:#9a856b;line-height:1.8;margin-top:12rpx}
.water-goal-input-row{display:flex;align-items:center;gap:20rpx;margin:26rpx 0 18rpx}.water-goal-field{flex:1;min-width:0;display:flex;align-items:center;border:1rpx solid #e6dcc7;border-radius:18rpx;padding:12rpx 18rpx;background:#fffdfa}.water-goal-field input{flex:1;min-width:0;width:0;height:60rpx;text-align:center;font-size:34rpx;color:inherit}.water-goal-field text{font-size:24rpx;color:#9a856b;margin-left:12rpx}
.water-goal-input-row button{flex:none;box-sizing:border-box;width:68rpx;height:68rpx;margin:0;padding:0;text-align:center;line-height:68rpx;font-size:30rpx;border-radius:18rpx;background:#f3ebd9;color:#735125}
.water-goal-actions{display:flex;gap:22rpx;margin-top:28rpx}.water-goal-actions button{flex:1;min-width:0;margin:0;padding:18rpx 8rpx;font-size:26rpx;line-height:1.6;text-align:center;border-radius:20rpx;background:#f3ebd9;color:#735125}.water-goal-actions .water-goal-save{background:#ffda68;color:#503312}.water-goal-dialog button::after{border:0}.water-goal-error{display:block;font-size:23rpx;line-height:1.7;color:#a44f39;margin-top:12rpx}
.ui-theme-light .water-goal-dialog{background:#fff7df}.ui-theme-dark .water-goal-dialog{background:#262b34;border-color:#465061;color:#e5e5df}.ui-theme-dark .water-goal-note,.ui-theme-dark .water-goal-field text{color:#aeb9ca}.ui-theme-dark .water-goal-field{background:#1c222d;border-color:#465061}.ui-theme-dark .water-goal-dialog button{background:#363e4b;color:#e5e5df}.ui-theme-dark .water-goal-actions .water-goal-save{background:#dbbc68;color:#292314}.ui-theme-dark .water-goal-error{color:#f4938c}

.goal-edit-label{display:flex;align-items:center;gap:8rpx;flex:none;line-height:1.5}.goal-edit-chevron{font-size:30rpx;line-height:1;color:#a28b60;font-weight:400}.ui-theme-dark .goal-edit-chevron{color:#d2bb80}

.energy-empty{display:flex;align-items:flex-end;box-sizing:border-box;padding-bottom:21rpx;gap:12rpx;width:94rpx;height:112rpx;flex:none;color:#593524}.energy-empty>view{height:8rpx;flex:1;background:currentColor}.ui-theme-dark .energy-empty{color:#e5e5df}
