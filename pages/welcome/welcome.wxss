page{background:#fffbef}
.welcome-page{position:relative;box-sizing:border-box;height:100vh;min-height:0;display:flex;align-items:center;justify-content:center;padding:calc(36rpx + env(safe-area-inset-top)) 32rpx calc(100rpx + env(safe-area-inset-bottom));overflow:hidden;background:radial-gradient(ellipse at 50% 48%,#fff6d4 0%,#fffbed 44%,#fffbef 74%)}
.welcome-halo{position:absolute;left:50%;top:45%;width:650rpx;height:800rpx;transform:translate(-50%,-50%) rotate(-14deg);border-radius:50%;background:linear-gradient(135deg,rgba(255,255,255,.5),rgba(255,255,255,.03));border:1rpx solid rgba(255,255,255,.54);pointer-events:none}
.welcome-brand{position:relative;width:100%;display:flex;align-items:center;flex-direction:column;flex-shrink:0}
.welcome-logo{display:block;width:256rpx;height:256rpx;border-radius:54rpx;overflow:hidden}
.welcome-slogan{display:block;width:340rpx;max-width:100%;height:112rpx;margin-top:42rpx}
.welcome-loading{position:absolute;bottom:calc(126rpx + env(safe-area-inset-bottom));left:0;width:100%;display:flex;justify-content:center;gap:16rpx}
.welcome-loading view{width:13rpx;height:13rpx;border-radius:50%;background:#ffd33f;animation:dot-breathe 1.1s ease-in-out infinite}
.welcome-loading view:nth-child(2){animation-delay:.16s}.welcome-loading view:nth-child(3){animation-delay:.32s}
.welcome-retry{position:absolute;bottom:calc(110rpx + env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);padding:12rpx 40rpx;background:#ffe18a;color:#765029;font-size:24rpx;line-height:2;border-radius:40rpx}.welcome-retry:after{border:0}
@keyframes dot-breathe{0%,100%{opacity:.35}50%{opacity:1}}
@media(prefers-reduced-motion:reduce){.welcome-loading view{animation:none}}

@import "../../styles/surfaces.wxss";

@media(max-height:480px){.welcome-logo{width:190rpx;height:190rpx;border-radius:40rpx}.welcome-slogan{margin-top:24rpx;height:100rpx}.welcome-loading{bottom:calc(40rpx + env(safe-area-inset-bottom))}}
