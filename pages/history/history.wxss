.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 32rpx 32rpx 220rpx;
}

.state-card {
    padding: 48rpx 36rpx;
    border-radius: 28rpx;
    background: rgba(255, 255, 255, 0.62);
    backdrop-filter: blur(14rpx);
    -webkit-backdrop-filter: blur(14rpx);
    border: 2rpx solid rgba(255, 255, 255, 0.65);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.spinner {
    width: 44rpx;
    height: 44rpx;
    border: 6rpx solid #fff0b8;
    border-top-color: #a76b11;
    border-radius: 50%;
}

.state-icon {
    font-size: 64rpx;
}

.state-title {
    margin-top: 20rpx;
    font-size: 32rpx;
    font-weight: 600;
}

.state-desc {
    margin-top: 12rpx;
    color: #a29180;
    font-size: 26rpx;
}

.primary-button {
    margin-top: 28rpx;
    background: linear-gradient(135deg, #ffd555, #a76b11);
    color: #ffffff;
    font-size: 28rpx;
    border: none;
    box-shadow: 0 8rpx 24rpx rgba(230, 174, 26, 0.35);
}

.day-card {
    margin-bottom: 24rpx;
    padding: 28rpx 32rpx;
    border-radius: 28rpx;
    background: rgba(255, 255, 255, 0.62);
    backdrop-filter: blur(14rpx);
    -webkit-backdrop-filter: blur(14rpx);
    border: 2rpx solid rgba(255, 255, 255, 0.65);
    box-shadow: 0 12rpx 40rpx rgba(100, 68, 22, 0.05);
}

.day-head {
    display: flex;
    flex-direction: column;
}

.day-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

/* 日期头右侧：总量 + 折叠箭头，箭头转起来表示这行可以点 */
.day-head-right {
    display: flex;
    align-items: center;
}

.day-caret {
    margin-left: 10rpx;
    color: #b3b8bf;
    font-size: 30rpx;
    line-height: 1;
    transition: transform 200ms ease;
}

/* 展开时箭头从朝右转向朝下 */
.day-caret-open {
    transform: rotate(90deg);
}

.day-head-hover {
    opacity: 0.72;
}

.day-date {
    font-size: 30rpx;
    font-weight: 600;
}

.day-total {
    color: #a76b11;
    font-size: 28rpx;
    font-weight: 600;
}

.day-total-over {
    color: #e5484d;
}

.day-percent {
    color: #a29180;
    font-size: 24rpx;
    font-weight: 400;
}

.day-bar {
    margin-top: 16rpx;
    height: 12rpx;
    border-radius: 6rpx;
    background: rgba(255, 255, 255, 0.8);
    overflow: hidden;
}

.day-bar-fill {
    height: 100%;
    border-radius: 6rpx;
}

.day-detail {
    margin-top: 8rpx;
}

.record-item {
    display: flex;
    align-items: center;
    padding: 18rpx 0;
    border-bottom: 2rpx solid #f7f8fa;
}

.record-item:last-child {
    border-bottom: none;
    padding-bottom: 4rpx;
}

.record-meal {
    width: 72rpx;
    color: #a29180;
    font-size: 24rpx;
}

.record-name {
    flex: 1;
    color: #432b1d;
    font-size: 28rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.record-kcal {
    margin-left: 16rpx;
    color: #86725e;
    font-size: 26rpx;
    flex-shrink: 0;
}

.record-delete {
    margin-left: 24rpx;
    padding: 16rpx 4rpx 16rpx 20rpx;
    flex-shrink: 0;
    color: #a29180;
    font-size: 24rpx;
    line-height: 1;
}

.record-delete-active {
    color: #e5484d;
    font-weight: 600;
}


.page { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }

@import "../../styles/cream.wxss";

@import "../../styles/surfaces.wxss";

