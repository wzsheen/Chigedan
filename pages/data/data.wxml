<view class="page {{uiThemeClass}}">
    <view class="header">
        <text class="page-title">数据管理</text>
        <text class="page-sub">备份记录、目标与用户配置（不包含 API Key）</text>
    </view>

    <view class="card">
        <view class="stat-row">
            <view class="stat-cell">
                <text class="stat-value">{{recordCount}}</text>
                <text class="stat-label">饮食</text>
            </view>
            <view class="stat-cell">
                <text class="stat-value">{{weightCount}}</text>
                <text class="stat-label">体重</text>
            </view>
            <view class="stat-cell">
                <text class="stat-value">{{waterCount}}</text>
                <text class="stat-label">饮水</text>
            </view>
            <view class="stat-cell">
                <text class="stat-value stat-value-small">{{storageText}}</text>
                <text class="stat-label">占用</text>
            </view>
        </view>
    </view>

    <view class="card">
        <text class="card-title">导入</text>
        <text class="card-desc">把「复制全部数据」得到的内容粘贴回来，解析后确认导入。</text>
        <view class="mode-row">
            <view class="mode-chip {{importMode === 'merge' ? 'mode-active' : ''}}" data-key="merge" bindtap="handleMode">
                <text>合并导入</text>
            </view>
            <view class="mode-chip {{importMode === 'replace' ? 'mode-active' : ''}}" data-key="replace" bindtap="handleMode">
                <text>覆盖导入</text>
            </view>
        </view>
        <text class="mode-hint">{{importMode === 'merge' ? '保留现有数据，只补缺少的日期与记录' : '先清空全部数据，只保留导入内容（含目标、档案与配置）'}}</text>
        <textarea
            class="paste"
            placeholder="把导出的文本粘贴到这里"
            value="{{importText}}"
            bindinput="handleImportInput"
            maxlength="-1"
        />
        <view class="btn-row">
            <view class="btn btn-ghost" bindtap="handleReadClipboard">
                <text>读剪贴板</text>
            </view>
            <view class="btn btn-primary" bindtap="handleParseImport">
                <text>解析</text>
            </view>
        </view>
        <view class="preview" wx:if="{{importSummary}}">
            <text class="preview-title">识别结果 · {{importSummary.sourceText}}</text>
            <view class="preview-row" wx:if="{{importSummary.configurationCount}}"><text>用户配置</text><text>{{importSummary.configurationCount}} 项</text></view>
            <view class="preview-row">
                <text>饮食记录</text>
                <text>{{importSummary.recordCount}} 条</text>
            </view>
            <view class="preview-row">
                <text>体重记录</text>
                <text>{{importSummary.weightCount}} 条</text>
            </view>
            <view class="preview-row">
                <text>饮水记录</text>
                <text>{{importSummary.waterCount}} 天</text>
            </view>
            <view class="preview-row">
                <text>个人食物</text><text>{{importSummary.foodCount || 0}} 种</text>
            </view>
            <view class="preview-row" wx:if="{{importSummary.goalText}}">
                <text>每日目标</text>
                <text>{{importSummary.goalText}}</text>
            </view>
            <text class="hint" wx:if="{{importSummary.measurementCount > 0}}">身体测量 {{importSummary.measurementCount}} 条</text><text class="preview-warn" wx:if="{{importSummary.skipped > 0}}">{{importSummary.skipped}} 行没认出，会被跳过</text>
            <view class="btn-row">
                <view class="btn btn-ghost" bindtap="handleCancelImport">
                    <text>取消</text>
                </view>
                <view class="btn btn-primary" bindtap="handleConfirmImport">
                    <text>{{importMode === 'replace' ? '确认覆盖' : '确认合并'}}</text>
                </view>
            </view>
        </view>
        <text class="hint" wx:if="{{importHint}}">{{importHint}}</text>
        <text class="hint hint-danger" wx:if="{{importError}}">{{importError}}</text>
    </view>

    <view class="card">
        <text class="card-title">导出</text>
        <text class="card-desc">复制数据后，可粘贴到备忘录或表格中保存与查看。</text>
        <view class="btn btn-ghost {{busy ? 'btn-disabled' : ''}}" bindtap="handleExport">
            <text>{{busy ? '正在整理…' : '复制全部数据（纯文本）'}}</text>
        </view>
        <text class="hint" wx:if="{{exportHint}}">{{exportHint}}</text>
        <textarea
            class="fallback"
            wx:if="{{showFallback}}"
            value="{{fallbackText}}"
            disabled
            maxlength="-1"
        />
    </view>

    <view class="card card-danger">
        <text class="card-title">清空</text>
        <text class="card-desc">删除本机的全部饮食、体重、饮水记录，以及目标、身体档案和昵称。删除后无法恢复，建议先导出备份。</text>
        <view class="btn {{confirmClear ? 'btn-danger-confirm' : 'btn-danger'}}" bindtap="handleClear">
            <text>{{confirmClear ? '再点一次确认清空' : '清空所有数据'}}</text>
        </view>
        <text class="hint hint-danger" wx:if="{{confirmClear}}">点「再点一次」后立即删除，4 秒内不点则自动取消</text>
    </view>
</view>
