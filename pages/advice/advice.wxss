@import "../../styles/cream.wxss";
.page{padding:28rpx 28rpx calc(50rpx + env(safe-area-inset-bottom));box-sizing:border-box;min-height:100vh}
.page-tabs{display:flex;padding:5rpx;border-radius:28rpx;background:rgba(237,228,204,.38);margin-bottom:26rpx}.page-tab{flex:1;text-align:center;padding:19rpx 0;color:#8e7960;font-size:28rpx;border-radius:24rpx}.page-tab-active{color:#503419;background:linear-gradient(115deg,rgba(255,225,108,.9),rgba(255,211,57,.65));font-weight:600}
.today-date{display:block;font-size:25rpx;color:#846b4d;margin-bottom:20rpx}.status-card{padding:28rpx;border-radius:28rpx;background:rgba(255,244,212,.53);border:1rpx solid rgba(255,255,255,.65)}.status-good{background:rgba(218,240,210,.52)}.status-adjust{background:rgba(250,209,193,.5)}.status-title{display:block;font-size:31rpx;color:#5b351e;font-weight:600;line-height:1.55}.status-basis{display:block;color:#9d8065;font-size:22rpx;margin-top:8rpx}.status-message{display:block;color:#8e7052;font-size:24rpx;line-height:1.7;margin-top:12rpx}
.intake-grid{display:flex;gap:12rpx;margin:18rpx 0 32rpx}.intake-grid>view{flex:1;min-width:0;padding:18rpx 12rpx;background:rgba(255,255,255,.48);border-radius:20rpx}.intake-label{display:block;font-size:21rpx;color:#a08b72}.intake-value{display:block;font-size:26rpx;margin-top:10rpx;font-weight:600;color:#6f4f2d}.intake-small{font-size:23rpx}.section-title{display:block;font-size:31rpx;font-weight:600;line-height:1.5;color:#51331d}.section-sub{display:block;color:#a28c70;font-size:23rpx;line-height:1.6;margin-top:8rpx}.recommend-heading,.library-heading{margin:28rpx 2rpx 22rpx}.meal-tabs{display:flex;gap:12rpx;margin:20rpx 0}.meal-tab{flex:1;text-align:center;padding:18rpx 0;border-radius:22rpx;background:rgba(255,255,255,.5);font-size:25rpx;color:#967e63}.meal-active{background:rgba(255,221,107,.62);color:#694b1e;font-weight:600}.library-count{display:block;font-size:23rpx;color:#86693f;margin:22rpx 4rpx}.recipe-search{height:76rpx;box-sizing:border-box;border-radius:24rpx;padding:0 26rpx;background:rgba(255,255,255,.56);border:1rpx solid rgba(255,255,255,.7);font-size:25rpx;margin:16rpx 0 24rpx}
.page .recipe-card{padding:0;margin:18rpx 0;background:rgba(255,254,248,.64);border:1rpx solid rgba(255,255,255,.7);border-radius:28rpx;box-shadow:0 5rpx 22rpx rgba(120,88,28,.035);overflow:hidden}.recipe-header{display:flex;align-items:center;padding:18rpx 18rpx;gap:18rpx}.recipe-photo{position:relative;width:128rpx;height:140rpx;flex-shrink:0;border-radius:20rpx;overflow:hidden}.photo-caption{position:absolute;bottom:0;left:0;right:0;text-align:center;background:rgba(255,252,237,.65);font-size:16rpx;color:#8e7759;padding:3rpx}.recipe-copy{flex:1;min-width:0}.recipe-name{display:block;font-size:28rpx;font-weight:600;line-height:1.45;color:#51331d}.recipe-subtitle{display:block;font-size:22rpx;color:#a38b6f;margin-top:8rpx;line-height:1.5}.recipe-meta{display:flex;flex-wrap:wrap;gap:10rpx;align-items:center;margin-top:12rpx}.recipe-energy{color:#654323;font-size:26rpx;font-weight:600}.recipe-tag{font-size:19rpx;padding:5rpx 12rpx;border-radius:14rpx;background:rgba(255,231,155,.46);color:#9c6e2b}.recipe-chevron{font-size:31rpx;color:#8b6d49;padding:14rpx 6rpx}
.recipe-detail{padding:0 22rpx 24rpx;border-top:1rpx solid #f0e8d7}.detail-title{display:block;margin:24rpx 0 14rpx;font-size:25rpx;font-weight:600;color:#74502a;border-left:5rpx solid #f5cf65;padding-left:12rpx}.portion-line{display:flex;justify-content:space-between;gap:14rpx;padding:12rpx 2rpx;border-bottom:1rpx solid rgba(202,183,145,.16);font-size:23rpx;color:#8b7456}.nutrition-grid{display:flex;gap:10rpx;padding:12rpx 0}.nutrition-cell{flex:1;min-width:0;display:flex;flex-direction:column;gap:8rpx;font-size:21rpx;color:#ac9271;text-align:center}.nutrition-value{font-size:26rpx;font-weight:600;color:#6a4728;line-height:1.4}.nutrition-table{border-radius:16rpx;background:rgba(241,230,203,.28);padding:8rpx 10rpx}.table-row{display:flex;align-items:center;padding:13rpx 0;border-bottom:1rpx solid rgba(202,183,145,.14);gap:8rpx;font-size:21rpx;color:#7d6549}.table-heading{font-size:20rpx;color:#a18c6d}.table-food{width:25%;flex-shrink:0}.table-energy{width:27%;font-size:19rpx}.table-number{flex:1;min-width:0;text-align:right;font-size:20rpx}.food-facts{background:rgba(255,240,195,.36);border-radius:20rpx;padding:2rpx 18rpx 20rpx;margin-top:20rpx}.fact-line{margin:16rpx 0}.fact-name{display:block;font-size:23rpx;font-weight:600;color:#88652e}.fact-text{display:block;font-size:23rpx;color:#967c56;line-height:1.8;margin-top:7rpx}.fact-source,.portion-note{display:block;color:#ad9879;font-size:20rpx;line-height:1.7;margin-top:16rpx}.source-link{color:#9b772f;font-size:22rpx;padding-top:18rpx}.recipe-save{margin-top:22rpx;padding:23rpx;text-align:center;background:linear-gradient(110deg,#ffe9a6,#ffce36);border-radius:24rpx;color:#664316;font-size:27rpx;font-weight:600}.recipe-over{display:block;color:#b57d38;font-size:22rpx;line-height:1.6;margin-top:18rpx}.empty-hint{padding:22rpx;color:#a68c6c;font-size:24rpx;line-height:1.7}.page-footnote{display:block;color:#b19c7f;font-size:22rpx;line-height:1.7;margin:28rpx 10rpx}

.recipe-atlas{position:absolute;width:400%;height:300%;}

@import "../../styles/surfaces.wxss";

.recipe-chevron{font-size:32rpx;}
