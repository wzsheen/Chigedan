<view class="plan-page {{uiThemeClass}} {{keypadField ? 'plan-page-keypad-open' : ''}}" bindtap="handlePageTap">
  <view class="plan-heading"><view><text class="plan-title">每日计划</text><text class="plan-sub">根据你的身体信息和目标，计算个性化的每日热量与营养建议。</text></view><image src="/assets/mascot/balanced-0.png" mode="aspectFit" /></view>
  <view class="plan-hero"><text class="eyebrow">每日热量目标 <text class="hero-question" bindtap="handleBasis">?</text></text><view class="plan-total"><text>{{result ? result.kcalDisplay : currentGoalValue}}</text><text class="plan-unit">{{energyUnit}}</text></view><text class="plan-muted" wx:if="{{!result}}">当前目标 · 完善资料可重新计算</text></view>
  <text class="plan-error" wx:if="{{error}}">{{error}}</text>
  <view class="plan-card"><view class="plan-card-heading"><text class="plan-section">身体资料</text><view class="plan-unit-tabs"><view class="{{unitMode === 'metric' ? 'unit-selected' : ''}}" data-mode="metric" bindtap="handleUnitMode">公制</view><view class="{{unitMode === 'imperial' ? 'unit-selected' : ''}}" data-mode="imperial" bindtap="handleUnitMode">英制</view></view></view><view class="plan-segments sex-segments"><view class="{{sex === 'male' ? 'selected' : ''}}" data-key="male" bindtap="handleSex">男</view><view class="{{sex === 'female' ? 'selected' : ''}}" data-key="female" bindtap="handleSex">女</view></view>
    <view class="profile-fields"><view class="profile-field"><text>年龄</text><view class="plan-input plan-field-ageText {{keypadField === 'ageText' ? 'plan-input-active' : ''}}" data-field="ageText" catchtap="openKeypad" aria-role="button" aria-label="年龄，{{ageText || '未填写'}}岁"><text class="plan-input-value {{!ageText ? 'plan-input-placeholder' : ''}}">{{ageText || '28'}}</text><text>岁</text></view></view><view class="profile-field"><text>身高</text><view class="plan-input plan-field-heightText {{keypadField === 'heightText' ? 'plan-input-active' : ''}}" data-field="heightText" catchtap="openKeypad" aria-role="button" aria-label="身高，{{heightText || '未填写'}}{{heightUnit}}"><text class="plan-input-value {{!heightText ? 'plan-input-placeholder' : ''}}">{{heightText || (heightUnit === 'in' ? '67' : '170')}}</text><text>{{heightUnit}}</text></view></view><view class="profile-field"><text>体重</text><view class="plan-input plan-field-weightText {{keypadField === 'weightText' ? 'plan-input-active' : ''}}" data-field="weightText" catchtap="openKeypad" aria-role="button" aria-label="体重，{{weightText || '未填写'}}{{weightUnit}}"><text class="plan-input-value {{!weightText ? 'plan-input-placeholder' : ''}}">{{weightText || weightPlaceholder}}</text><text>{{weightUnit}}</text></view></view></view>
  </view>
  <view class="plan-card activity-card {{activityOpen ? 'activity-card-open' : ''}}"><text class="plan-section">活动与目标</text><view class="plan-setting-row"><text class="plan-label">日常活动强度</text><view class="activity-picker"><view class="activity-current" catchtap="toggleActivity" role="button" aria-label="日常活动强度，{{activities[activityIndex].label}}，{{activityOpen ? '点击收起' : '点击展开'}}"><view><text>{{activities[activityIndex].label}}</text><text class="activity-current-desc">{{activities[activityIndex].desc}}</text></view><text class="picker-caret">{{activityOpen ? '▴' : '▾'}}</text></view><view class="activity-options" wx:if="{{activityOpen}}"><view wx:for="{{activities}}" wx:key="key" class="activity-option {{selectedActivity === item.key ? 'activity-option-selected' : ''}}" data-key="{{item.key}}" catchtap="handleActivity" role="button" aria-label="{{item.label}}，{{item.desc}}，{{selectedActivity === item.key ? '已选中' : '未选中'}}"><view class="activity-option-copy"><text class="activity-option-label">{{item.label}}</text><text class="activity-option-desc">{{item.desc}}</text></view><text class="activity-option-check">{{selectedActivity === item.key ? '✓' : ''}}</text></view></view></view></view><view class="plan-setting-row goal-setting-row"><text class="plan-label">我的目标</text><view class="plan-segments goal-segments"><view wx:for="{{goalTypes}}" wx:key="key" class="{{selectedGoal === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="handleGoalType">{{item.label}}</view></view></view></view>
  <view class="plan-card"><text class="plan-section">营养与饮水 <text class="section-question" bindtap="handleBasis">?</text></text><view class="plan-nutrients"><view><text class="nutrient-label"><text class="nutrient-dot dot-carb"></text>碳水化合物</text><text class="nutrient-value">{{result ? result.carbText : currentTargets.carb}}<text> g</text></text><text class="nutrient-ratio">45%</text></view><view><text class="nutrient-label"><text class="nutrient-dot dot-protein"></text>蛋白质</text><text class="nutrient-value">{{result ? result.proteinText : currentTargets.protein}}<text> g</text></text><text class="nutrient-ratio">25%</text></view><view><text class="nutrient-label"><text class="nutrient-dot dot-fat"></text>脂肪</text><text class="nutrient-value">{{result ? result.fatText : currentTargets.fat}}<text> g</text></text><text class="nutrient-ratio">30%</text></view></view>
  <view class="plan-water"><image src="/assets/icons/line-water.png" mode="aspectFit" /><text class="water-label">每日饮水</text><view class="water-step" bindtap="handleWaterMinus" aria-label="减少100毫升">−</view><view class="water-input plan-field-waterGoalText {{keypadField === 'waterGoalText' ? 'plan-input-active' : ''}}" data-field="waterGoalText" catchtap="openKeypad" aria-role="button" aria-label="每日饮水，{{waterGoalText || '未填写'}}毫升">{{waterGoalText}}</view><view class="water-step" bindtap="handleWaterPlus" aria-label="增加100毫升">＋</view><text class="water-unit">ml</text></view>
  <view class="plan-basis"><view class="basis-trigger" bindtap="handleBasis"><text>怎么算的？</text><text>{{showBasis ? '−' : '＋'}}</text></view><view wx:if="{{showBasis}}" class="basis-body"><view>使用 Mifflin-St Jeor 公式，结合活动水平及目标估算。</view><view wx:if="{{result}}">基础代谢 {{result.bmrDisplay}} {{energyUnit}} · 每日总消耗 {{result.tdeeDisplay}} {{energyUnit}}</view><view>{{adjustHint}}</view><view>{{minHint}}</view></view></view>
  </view>
  <view class="plan-footer"><view class="plan-save" bindtap="handleSave" aria-role="button">保存计划</view></view>
  <view class="plan-keypad" wx:if="{{keypadField}}" catchtap="noopKeypad">
    <view class="plan-keypad-head"><view><text>{{keypadLabel}}</text><text class="plan-keypad-unit">{{keypadUnit}}</text></view><view class="plan-keypad-actions"><text wx:if="{{keypadField !== 'waterGoalText'}}" catchtap="nextKeypadField">下一项</text><text catchtap="closeKeypad">完成</text></view></view>
    <view class="plan-keypad-grid"><view wx:for="{{['1','2','3','4','5','6','7','8','9']}}" wx:key="*this" class="plan-keypad-key" data-key="{{item}}" catchtap="handleKeypadKey" aria-role="button" aria-label="{{item}}">{{item}}</view><view class="plan-keypad-key {{!keypadDecimal ? 'plan-keypad-disabled' : ''}}" data-key="." catchtap="handleKeypadKey" aria-role="button" aria-label="小数点" aria-disabled="{{!keypadDecimal}}">.</view><view class="plan-keypad-key" data-key="0" catchtap="handleKeypadKey" aria-role="button" aria-label="0">0</view><view class="plan-keypad-key plan-keypad-function" data-key="back" catchtap="handleKeypadKey" aria-role="button" aria-label="退格">⌫</view></view>
  </view>
</view>
