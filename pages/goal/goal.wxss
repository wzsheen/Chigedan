page{background:#fffbf2;background-image:radial-gradient(ellipse at 95% 6%,rgba(255,226,125,.13),transparent 60%)}
.plan-page{box-sizing:border-box;min-height:100vh;padding:24rpx 28rpx calc(148rpx + env(safe-area-inset-bottom));color:#503723}
.plan-heading{position:relative;min-height:145rpx;margin:4rpx 0 18rpx;display:flex;align-items:center;z-index:1}.plan-heading>view{width:70%;padding-top:6rpx}.plan-heading image{position:absolute;right:0;top:-6rpx;width:192rpx;height:228rpx;pointer-events:none}.plan-title{display:block;font-size:40rpx;font-weight:700;line-height:1.4}.plan-sub{display:block;font-size:22rpx;line-height:1.7;color:#9c8975;margin-top:10rpx;max-width:440rpx}
.plan-hero{padding:27rpx 32rpx 24rpx;border:2rpx solid #fff;border-radius:32rpx;background:#fff3c7;background-image:linear-gradient(115deg,#fff4ca,#fff9e9);box-shadow:0 5rpx 22rpx rgba(151,113,26,.035)}.eyebrow{font-size:27rpx;font-weight:600}.hero-question,.section-question{display:inline-block;font-size:19rpx;font-weight:400;color:#aa9270;border:1rpx solid #b8a27f;border-radius:50%;height:22rpx;width:22rpx;text-align:center;line-height:22rpx;vertical-align:middle;margin-left:10rpx}.plan-total{margin:12rpx 0 0;display:flex;align-items:baseline}.plan-total>text:first-child{font-size:106rpx;letter-spacing:-3rpx;font-weight:700;line-height:1.12}.plan-total .plan-unit{font-size:35rpx;margin-left:18rpx;font-weight:600}.plan-muted{display:block;font-size:20rpx;color:#b19b70;margin-top:10rpx}
.plan-card{background:rgba(255,255,255,.86);border:1rpx solid #f1eadf;border-radius:30rpx;padding:23rpx 25rpx;margin-top:20rpx;box-shadow:0 4rpx 18rpx rgba(120,84,27,.025)}.plan-section{display:block;font-size:28rpx;font-weight:600;line-height:1.4}.plan-card-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:12rpx}.plan-unit-tabs{display:flex;background:#f7f3ec;padding:3rpx;border-radius:18rpx;flex:none}.plan-unit-tabs>view{font-size:21rpx;color:#a38e74;padding:9rpx 16rpx;border:1rpx solid transparent;border-radius:15rpx}.plan-unit-tabs .unit-selected{background:#fff0bb;color:#816026;border-color:#efcf77}
.plan-segments{display:flex;align-items:center;padding:4rpx;background:#f8f5ef;border-radius:30rpx}.plan-segments>view{flex:1;text-align:center;padding:13rpx 0;border-radius:27rpx;font-size:24rpx;color:#917d68;border:1rpx solid transparent}.plan-segments .selected{background:#ffdf79;color:#503312;border-color:#edc562;font-weight:600}.sex-segments{width:270rpx;margin-bottom:17rpx}.sex-segments>view{padding:11rpx 0}.profile-fields{display:flex;justify-content:space-between}.profile-field{width:31%}.profile-field>text{display:block;font-size:22rpx;color:#9a8979;margin:0 0 8rpx 8rpx}.plan-input{display:flex;align-items:center;border:1rpx solid #eee7d9;border-radius:20rpx;padding:0 16rpx;height:72rpx;box-sizing:border-box;background:#fffdfa}.plan-input input{flex:1;width:0;min-width:0;font-size:27rpx}.plan-input>text{font-size:20rpx;color:#a28d77;margin-left:6rpx}
.activity-card>.plan-section{margin-bottom:20rpx}.plan-setting-row{display:flex;align-items:center;justify-content:space-between}.plan-label{font-size:23rpx;color:#9a8979;flex:none;margin-right:18rpx}.activity-picker{width:65%;display:block}.activity-current{display:flex;align-items:center;justify-content:space-between;box-sizing:border-box;min-height:88rpx;border:1rpx solid #eee7d9;border-radius:20rpx;padding:12rpx 20rpx;background:#fbf9f5}.activity-current>view>text{display:block;font-size:25rpx;font-weight:600;line-height:1.4}.activity-current>view>.activity-current-desc{font-size:20rpx;font-weight:400;color:#a18c72;margin-top:5rpx}.picker-caret{font-size:27rpx;color:#9b866a;margin-left:14rpx}.goal-setting-row{margin-top:20rpx}.goal-segments{width:78%}.goal-segments>view{font-size:23rpx}
.plan-nutrients{display:flex;padding:23rpx 0}.plan-nutrients>view{width:33.33%;text-align:center;border-right:1rpx solid #f1eadc}.plan-nutrients>view:last-child{border:0}.nutrient-label,.nutrient-ratio,.nutrient-value{display:block}.nutrient-label{font-size:21rpx;color:#96836f;white-space:nowrap}.nutrient-dot{display:inline-block;width:16rpx;height:16rpx;border-radius:50%;margin-right:7rpx;vertical-align:middle}.dot-carb{background:#ffcf5e}.dot-protein{background:#a6c995}.dot-fat{background:#f6a083}.nutrient-value{font-size:33rpx;font-weight:600;margin:10rpx 0 5rpx}.nutrient-value text{font-size:21rpx;font-weight:400}.nutrient-ratio{font-size:19rpx;color:#b1a08b}
.plan-water{display:flex;align-items:center;padding-top:5rpx}.plan-water image{width:30rpx;height:36rpx;margin-right:9rpx;flex:none}.water-label{font-size:23rpx;flex:1}.water-step{width:51rpx;height:58rpx;line-height:58rpx;text-align:center;background:#f8f4ed;border:1rpx solid #eee7da;border-radius:18rpx;font-size:27rpx;flex:none}.plan-water input{box-sizing:border-box;width:116rpx;height:58rpx;text-align:center;background:#fffdfa;border:1rpx solid #eee7da;border-radius:18rpx;margin:0 10rpx;font-size:25rpx}.water-unit{font-size:21rpx;color:#9a8979;margin-left:10rpx}
.plan-basis{margin-top:20rpx;background:#f8f5ee;border-radius:18rpx;padding:14rpx 18rpx}.basis-trigger{display:flex;justify-content:space-between;font-size:22rpx;color:#907857}.basis-body{font-size:21rpx;line-height:1.85;color:#9a8979;margin-top:18rpx}.basis-body>view+view{margin-top:12rpx}.plan-footer{position:fixed;bottom:0;left:0;right:0;padding:16rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));background:#fffbf2;z-index:5}.plan-save{height:82rpx;line-height:82rpx;text-align:center;border-radius:26rpx;background:#ffda61;color:#503312;font-weight:600;font-size:29rpx}.plan-error{display:block;background:#fce6df;color:#a44f39;padding:20rpx;border-radius:20rpx;margin-top:20rpx;font-size:24rpx}

@import "../../styles/surfaces.wxss";

.picker-caret{font-size:32rpx;}

.activity-current>view{min-width:0;flex:1}
.activity-card{position:relative}
.activity-card-open{z-index:6}
.activity-picker{position:relative}
.activity-options{position:absolute;top:100%;left:0;right:0;z-index:7;margin-top:10rpx;box-shadow:0 12rpx 36rpx rgba(80,55,35,.18);border:1rpx solid #eee7d9;border-radius:20rpx;overflow:hidden;background:#fffdfa}
.activity-option{display:flex;align-items:center;justify-content:space-between;min-height:96rpx;box-sizing:border-box;padding:16rpx 20rpx;border-top:1rpx solid #eee7d9}
.activity-option:first-child{border-top:0}
.activity-option-copy{flex:1;min-width:0}
.activity-option-label,.activity-option-desc{display:block;line-height:1.5}
.activity-option-label{font-size:25rpx;font-weight:600}
.activity-option-desc{font-size:22rpx;color:#917d68;margin-top:4rpx}
.activity-option-check{width:36rpx;flex:none;text-align:center;margin-left:16rpx;font-size:30rpx;color:#816026}
.activity-option-selected{background:#fff0bb}
.ui-theme-light .activity-options{background:#fffaf0}
.ui-theme-dark .activity-options{background:#1c222d;border-color:#3e485b}
.ui-theme-dark .activity-option{border-color:#3e485b}
.ui-theme-dark .activity-option-selected{background:#343122}
.ui-theme-dark .activity-option-desc,.ui-theme-dark .activity-current .activity-current-desc{color:#aeb9ca}
.ui-theme-dark .activity-option-check{color:#e2c884}

.plan-input .plan-input-value{flex:1;min-width:0;margin:0;color:#503723;font-size:27rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.plan-input .plan-input-placeholder{color:#aaa29a}.plan-water .water-input{box-sizing:border-box;width:116rpx;height:58rpx;line-height:58rpx;text-align:center;background:#fffdfa;border:1rpx solid #eee7da;border-radius:18rpx;margin:0 10rpx;font-size:25rpx;overflow:hidden;flex:none}.plan-input-active,.plan-water .water-input.plan-input-active{border-color:#d8ad43;box-shadow:0 0 0 2rpx rgba(225,182,68,.2)}
.plan-page-keypad-open{padding-bottom:calc(520rpx + env(safe-area-inset-bottom))}.plan-keypad{position:fixed;z-index:10;left:0;right:0;bottom:0;box-sizing:border-box;padding:18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));background:#fffaf0;border-radius:28rpx 28rpx 0 0;box-shadow:0 -8rpx 30rpx rgba(83,58,24,.15)}.plan-keypad-head{display:flex;align-items:center;justify-content:space-between;min-height:48rpx;margin-bottom:12rpx;font-size:26rpx;font-weight:600}.plan-keypad-unit{margin-left:10rpx;font-size:21rpx;font-weight:400;color:#9a8979}.plan-keypad-actions{display:flex;gap:28rpx;color:#9a6f24;font-size:24rpx}.plan-keypad-actions text{padding:8rpx}.plan-keypad-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx}.plan-keypad-key{display:flex;align-items:center;justify-content:center;height:68rpx;border:1rpx solid #eee6d8;border-radius:15rpx;background:#fff;font-size:30rpx;font-weight:600;color:#503723}.plan-keypad-key:active{background:#ffedb4}.plan-keypad-function{background:#f4ecdc}.plan-keypad-disabled{opacity:.3}
.ui-theme-dark .plan-input .plan-input-value{color:#edf0f6}.ui-theme-dark .plan-input .plan-input-placeholder{color:#8993a4}.ui-theme-dark .plan-water .water-input{background:#242b37;border-color:#465164;color:#edf0f6}.ui-theme-dark .plan-keypad{background:#202733;box-shadow:0 -8rpx 30rpx rgba(0,0,0,.3)}.ui-theme-dark .plan-keypad-key{background:#303949;border-color:#465164;color:#f0f1f5}.ui-theme-dark .plan-keypad-function{background:#3b4657}.ui-theme-dark .plan-keypad-key:active{background:#524b36}.ui-theme-dark .plan-keypad-actions{color:#efcf82}.ui-theme-dark .plan-keypad-unit{color:#aeb9ca}
