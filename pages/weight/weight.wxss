@import "../../styles/cream.wxss";
@import "../../styles/surfaces.wxss";
.body-state-page{box-sizing:border-box;min-height:100vh;padding:28rpx 28rpx calc(64rpx + env(safe-area-inset-bottom));color:#503723}.body-heading{margin:4rpx 4rpx 24rpx}.body-heading text{display:block}.body-heading .page-title{font-size:37rpx}.body-heading .page-sub{font-size:23rpx;margin-top:10rpx}.sheet-error{display:block;padding:20rpx;margin-bottom:20rpx;background:#fce9e0;color:#a34f3e;border-radius:18rpx;font-size:24rpx}
.body-state-page .summary-card,.body-state-page .height-card{box-sizing:border-box;padding:28rpx;margin-bottom:22rpx;border-radius:30rpx}.body-state-page .health-card{background:linear-gradient(120deg,#fff0b8,#fff9e6);border:1rpx solid #fff}.health-top{display:flex;align-items:center;justify-content:space-between;min-height:190rpx}.health-top>view{flex:1;min-width:0}.section-title{font-size:28rpx;font-weight:600;line-height:1.5}.health-mascot{width:180rpx;height:210rpx;flex:none;margin:-12rpx -6rpx -10rpx 8rpx}.score-number-row{display:flex;align-items:baseline;margin-top:8rpx}.health-number{font-size:94rpx;font-weight:700;line-height:1.2;letter-spacing:-2rpx}.score-unit{font-size:25rpx;color:#9c814b;margin-left:14rpx}.score-status{display:block;font-size:24rpx;line-height:1.6;margin-top:6rpx;color:#8a692b}.score-track{height:12rpx;border-radius:10rpx;background:rgba(151,116,42,.12);overflow:hidden;margin-top:24rpx}.score-fill{height:100%;border-radius:10rpx;background:#e7b73c}.score-ticks{display:flex;justify-content:space-between;font-size:19rpx;color:#a38c60;margin-top:9rpx}.score-disclaimer{display:block;font-size:21rpx;line-height:1.8;color:#927d57;margin-top:18rpx}
.section-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:20rpx}.section-caption{font-size:21rpx;color:#a18c72;flex:none}.weight-current{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding-bottom:24rpx}.metric-caption{display:block;font-size:23rpx;color:#9a856b;line-height:1.6}.weight-number-row{display:flex;align-items:baseline;margin-top:6rpx}.weight-number{font-size:59rpx;font-weight:600;line-height:1.3}.metric-unit{font-size:25rpx;color:#9a856b;margin-left:12rpx}.weight-source{max-width:45%;text-align:right}.body-date{display:block;font-size:21rpx;color:#a18c72;line-height:1.8;overflow-wrap:break-word;margin-top:8rpx}.body-note{display:block;font-size:22rpx;line-height:1.85;color:#9b876e;margin-top:16rpx;overflow-wrap:break-word}.measurement-grid{display:flex;border-top:1rpx solid rgba(160,132,78,.13);padding-top:24rpx}.measurement-grid>view{flex:1;min-width:0;padding:0 14rpx;text-align:center}.measurement-grid>view:first-child{padding-left:0}.measurement-grid>view:last-child{padding-right:0}.measurement-grid>view+view{border-left:1rpx solid rgba(160,132,78,.13)}.measurement-value{display:block;font-size:28rpx;font-weight:600;line-height:1.5;margin-top:8rpx}.measurement-grid .body-date{font-size:19rpx}
.indicator+.indicator{border-top:1rpx solid rgba(160,132,78,.13);padding-top:26rpx;margin-top:24rpx}.indicator-head{display:flex;align-items:center;justify-content:space-between;font-size:25rpx;margin-bottom:24rpx}.indicator-number{font-size:36rpx;font-weight:600}.reference-scale{position:relative;display:flex;height:14rpx;border-radius:10rpx;margin:0 7rpx}.reference-scale>view{flex:1}.reference-scale>view:nth-child(1){background:#aecbaa}.reference-scale>view:nth-child(2){background:#efd484}.reference-scale>view:nth-child(3){background:#e6ac9f}.reference-scale>view:nth-child(4){background:#e6ac9f}.bmi-scale>view:nth-child(1){background:#a7c6d6}.bmi-scale>view:nth-child(2){background:#aecbaa}.bmi-scale>view:nth-child(3){background:#efd484}.reference-scale>.scale-marker{position:absolute;top:-7rpx;width:8rpx;height:28rpx;box-sizing:border-box;border:2rpx solid #fff;border-radius:5rpx;background:#684c2d;transform:translateX(-50%);box-shadow:0 1rpx 5rpx rgba(60,40,20,.2)}.scale-labels{display:flex;font-size:20rpx;color:#9a866d;margin-top:14rpx;text-align:center}.scale-labels>text{flex:1}.metric-normal{color:#629b6b}.metric-low{color:#5f95b1}.metric-high{color:#b18a30}.metric-danger{color:#bc7567}
.body-trend-tabs{display:flex;padding:5rpx;border-radius:20rpx;background:#f6f0e3;margin-bottom:22rpx}.body-trend-tabs>view{flex:1;text-align:center;padding:14rpx 4rpx;font-size:24rpx;color:#9c8769;border-radius:16rpx}.body-trend-tabs .body-trend-active{background:#ffe28b;color:#73531d;font-weight:600}.range-tabs{display:flex;padding:4rpx;border-radius:16rpx;font-size:21rpx}.range-tabs>view{padding:10rpx 13rpx;border-radius:12rpx;color:#9c8769}.range-tabs .range-active{background:#ffe28b;color:#73531d}.trend-summary{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:27rpx;font-weight:600;line-height:1.7}.trend-summary>text:last-child{font-size:24rpx;color:#9f8355}.plot-meta{display:flex;justify-content:space-between;font-size:19rpx;color:#a18c72;margin-top:24rpx}.weight-plot{position:relative;width:600rpx;height:180rpx;margin:28rpx auto 0}.plot-grid{position:absolute;left:0;right:0;border-top:1rpx dashed rgba(160,132,78,.18)}.grid-top{top:0}.grid-middle{top:50%}.grid-bottom{bottom:0}.weight-lines{position:absolute;inset:0}.weight-segment{position:absolute;height:3rpx;background:#d2a43b;transform-origin:left center}.weight-dot{position:absolute;width:12rpx;height:12rpx;box-sizing:border-box;border:2rpx solid #fff;border-radius:50%;background:#d2a43b;transform:translate(-50%,-50%)}.weight-dot text{position:absolute;left:50%;bottom:15rpx;transform:translateX(-50%);white-space:nowrap;font-size:21rpx;color:#9b7935}.weight-range{display:flex;justify-content:space-between;font-size:19rpx;color:#a18c72;margin-top:20rpx}.chart-empty{text-align:center;padding:22rpx 0 16rpx;font-size:24rpx;color:#9c876e;line-height:1.8}.empty-chart{height:100rpx;display:flex;flex-direction:column;justify-content:space-between;margin-bottom:22rpx}.empty-chart>view{border-top:1rpx dashed rgba(160,132,78,.18);margin:0 12rpx}.trend-link{display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid rgba(160,132,78,.13);margin-top:22rpx;padding-to