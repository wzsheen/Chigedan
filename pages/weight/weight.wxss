.ui-theme-dark.body-state-page{color:#e5e5df}.ui-theme-dark .health-card{background:linear-gradient(120deg,#393521,#2a2b25);border-color:rgba(255,255,255,.09)}.ui-theme-dark .score-track{background:rgba(226,200,132,.13)}.ui-theme-dark .score-fill{background:#d6b45e}.ui-theme-dark .score-status,.ui-theme-dark .score-unit,.ui-theme-dark .score-ticks,.ui-theme-dark .score-disclaimer{color:#c8b888}.ui-theme-dark .body-date,.ui-theme-dark .body-note,.ui-theme-dark .metric-caption,.ui-theme-dark .metric-unit,.ui-theme-dark .section-caption,.ui-theme-dark .scale-labels,.ui-theme-dark .plot-meta,.ui-theme-dark .weight-range,.ui-theme-dark .chart-empty,.ui-theme-dark .page-footnote{color:#aeb9ca}.ui-theme-dark .measurement-grid,.ui-theme-dark .measurement-grid>view+view,.ui-theme-dark .indicator+.indicator,.ui-theme-dark .source-body,.ui-theme-dark .trend-link{border-color:rgba(255,255,255,.09)}.ui-theme-dark .body-trend-tabs,.ui-theme-dark .range-tabs{background:#1c222d}.ui-theme-dark .body-trend-tabs>view,.ui-theme-dark .range-tabs>view{color:#aeb9ca}.ui-theme-dark .body-trend-tabs .body-trend-active,.ui-theme-dark .range-tabs .range-active{background:#49402a;color:#e2c884}.ui-theme-dark .trend-summary>text:last-child,.ui-theme-dark .trend-link,.ui-theme-dark .source-toggle,.ui-theme-dark .weight-dot text{color:#d2bb80}.ui-theme-dark .plot-grid,.ui-theme-dark .empty-chart>view{border-color:rgba(255,255,255,.14)}.ui-theme-dark .weight-dot{border-color:#29303b}.ui-theme-dark .scale-marker{background:#f0e5c5;border-color:#292e36}.ui-theme-dark .metric-normal{color:#8ad59d}.ui-theme-dark .metric-high{color:#e5c167}.ui-theme-dark .metric-danger{color:#f4938c}.ui-theme-dark .metric-low{color:#8dbde2}

.ratio-scale>view:nth-child(1){background:#a7c6d6}.ratio-scale>view:nth-child(2){background:#aecbaa}.ratio-scale>view:nth-child(3){background:#efd484}.scale-labels>text{font-size:18rpx;white-space:nowrap}

.health-empty{display:flex;align-items:center;gap:12rpx;width:94rpx;height:112rpx}.health-empty>view{flex:1;height:8rpx;background:currentColor}

