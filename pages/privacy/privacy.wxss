@import "../../styles/cream.wxss";
.privacy-page{box-sizing:border-box;min-height:100vh;padding:32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom))}
.privacy-heading{margin-bottom:28rpx}.privacy-heading text{display:block}.privacy-heading .page-sub{font-size:22rpx;margin-top:12rpx}
.privacy-summary{padding:24rpx;border-radius:22rpx;background:#fff2c9;color:#816637;font-size:25rpx;line-height:1.8;margin-bottom:28rpx}
.privacy-section{padding:28rpx 26rpx;margin-bottom:22rpx}.privacy-title{display:block;font-size:28rpx;font-weight:600;line-height:1.6;color:#65472c}
.privacy-paragraph{display:block;margin-top:18rpx;font-size:25rpx;line-height:1.9;color:#8a745e;word-break:break-all}
.privacy-contact{display:flex;flex-direction:column;align-items:center;padding:28rpx 12rpx;font-size:25rpx;line-height:1.8;color:#795b36}
.privacy-copy{margin-top:14rpx;padding:12rpx 28rpx;border-radius:18rpx;background:#fff0bb;font-size:23rpx}.privacy-hint{display:block;text-align:center;color:#a18a68;font-size:22rpx}

/* 在线版入口：文字加粗 + 强调色，放在页面底部也能一眼看到 */
.privacy-web{display:block;margin-top:20rpx;padding:24rpx;border-radius:22rpx;background:#fff0bb}
.privacy-web-head{display:flex;align-items:center;justify-content:space-between}
.privacy-web-label{flex:1;min-width:0;font-size:25rpx;font-weight:700;color:#7a5410}
.privacy-web-action{flex:none;margin-left:16rpx;padding:10rpx 20rpx;border-radius:16rpx;background:#A76B11;color:#fff8e8;font-size:22rpx;font-weight:700}
.privacy-web-url{display:block;margin-top:12rpx;font-size:20rpx;line-height:1.6;color:#9a7f52;word-break:break-all}

@import "../../styles/surfaces.wxss";

/* 深色主题：放在 surfaces 之后，避免被覆盖 */
.ui-theme-dark .privacy-web{background:#343122}
.ui-theme-dark .privacy-web-label{color:#e2c27b}
.ui-theme-dark .privacy-web-url{color:#b9a780}
.ui-theme-dark .privacy-web-action{background:#d6b45e;color:#292415}
