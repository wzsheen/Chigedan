.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 32rpx 32rpx 80rpx;
}

.sheet-error {
    display: block;
    margin-bottom: 24rpx;
    padding: 20rpx 24rpx;
    border-radius: 16rpx;
    background: #fdecec;
    color: #e5484d;
    font-size: 26rpx;
}

.field-group {
    margin-bottom: 36rpx;
}

.field-label {
    display: block;
    margin-bottom: 16rpx;
    font-size: 28rpx;
    font-weight: 600;
    color: #432b1d;
}

.required {
    color: #e5484d;
}

.field-hint {
    display: block;
    margin-top: 12rpx;
    color: #a29180;
    font-size: 24rpx;
    line-height: 1.6;
}

.food-chips {
    display: flex;
    flex-wrap: wrap;
}

.food-chip {
    padding: 12rpx 24rpx;
    margin: 0 16rpx 16rpx 0;
    border-radius: 16rpx;
    background: rgba(255, 243, 236, 0.75);
    backdrop-filter: blur(20rpx);
    -webkit-backdrop-filter: blur(20rpx);
    color: #c2511d;
    font-size: 24rpx;
    border: 2rpx solid #ffdcc8;
}

.photo-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 220rpx;
    border: 2rpx dashed rgba(255, 255, 255, 0.95);
    border-radius: 20rpx;
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(20rpx);
    -webkit-backdrop-filter: blur(20rpx);
}

.photo-icon {
    font-size: 56rpx;
}

.photo-text {
    margin-top: 12rpx;
    color: #a29180;
    font-size: 26rpx;
}

.photo-preview {
    display: flex;
    align-items: center;
}

.photo-image {
    width: 220rpx;
    height: 220rpx;
    border-radius: 20rpx;
    background: #f2f3f5;
}

.photo-remove {
    margin-left: 24rpx;
    color: #a29180;
    font-size: 26rpx;
    text-decoration: underline;
}

.field-input {
    box-sizing: border-box;
    width: 100%;
    height: 84rpx;
    min-height: 84rpx;
    padding: 0 24rpx;
    border-radius: 16rpx;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(20rpx);
    -webkit-backdrop-filter: blur(20rpx);
    border: 2rpx solid rgba(255, 255, 255, 0.7);
    font-size: 28rpx;
    line-height: 80rpx;
}

.field-textarea {
    box-sizing: border-box;
    width: 100%;
    min-height: 120rpx;
    padding: 22rpx 24rpx;
    border-radius: 16rpx;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(20rpx);
    -webkit-backdrop-filter: blur(20rpx);
    border: 2rpx solid rgba(255, 255, 255, 0.7);
    font-size: 28rpx;
}

.macro-inputs {
    display: flex;
    justify-content: space-between;
}

.macro-input {
    width: 31%;
}

.portion-row {
    display: flex;
    align-items: flex-start;
}

.qty-input {
    width: 140rpx;
    flex: none;
    text-align: center;
}

.unit-picker {
    position: relative;
    flex: 1;
    margin-left: 16rpx;
    z-index: 30;
}

.unit-picker-trigger {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 84rpx;
    padding: 0 24rpx;
    border-radius: 16rpx;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(20rpx);
    -webkit-backdrop-filter: blur(20rpx);
    border: 2rpx solid rgba(255, 255, 255, 0.7);
}

.unit-picker-value {
    color: #432b1d;
    font-size: 28rpx;
}

.unit-picker-arrow {
    margin-left: 12rpx;
    color: #a29180;
    font-size: 24rpx;
    transition: transform 0.2s ease;
}

.unit-picker-arrow-open {
    transform: rotate(180deg);
}

.unit-menu {
    position: absolute;
    top: calc(100% + 10rpx);
    left: 0;
    right: 0;
    border-radius: 16rpx;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12rpx);
    -webkit-backdrop-filter: blur(12rpx);
    border: 2rpx solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 12rpx 40rpx rgba(100, 68, 22, 0.16);
    overflow: hidden;
    z-index: 40;
}

.unit-option {
    padding: 22rpx 24rpx;
    color: #432b1d;
    font-size: 28rpx;
    border-bottom: 2rpx solid rgba(100, 68, 22, 0.05);
}

.unit-option:last-child {
    border-bottom: none;
}

.unit-option-active {
    color: #a76b11;
    font-weight: 600;
    background: rgba(230, 174, 26, 0.08);
}

.total-hint {
    display: block;
    margin-top: 12rpx;
    color: #a76b11;
    font-size: 26rpx;
    font-weight: 600;
}

.suggestions {
    margin-top: 12rpx;
    border-radius: 16rpx;
    background: rgba(255, 255, 255, 0.75);
    border: 2rpx solid rgba(255, 255, 255, 0.8);
    overflow: hidden;
}

.suggestion-item {
    padding: 18rpx 24rpx;
    border-bottom: 2rpx solid rgba(255, 255, 255, 0.8);
    color: #432b1d;
    font-size: 26rpx;
}

.suggestion-item:last-child {
    border-bottom: none;
}

/* ---------- 本餐清单 ---------- */

.meal-list-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16rpx;
}

.meal-list-head .field-label {
    margin-bottom: 0;
}

.meal-list-count {
    margin-left: 10rpx;
    font-size: 24rpx;
    font-weight: 400;
    color: #c2511d;
}

.meal-clear {
    padding: 10rpx 24rpx;
    border-radius: 999rpx;
    background: rgba(255, 255, 255, 0.6);
    border: 2rpx solid rgba(255, 255, 255, 0.75);
    color: #a29180;
    font-size: 24rpx;
}

.meal-clear-active {
    background: #e5484d;
    border-color: #e5484d;
    color: #ffffff;
    font-weight: 600;
}

.meal-list {
    border-radius: 20rpx;
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(20rpx);
    -webkit-backdrop-filter: blur(20rpx);
    border: 2rpx solid rgba(255, 255, 255, 0.72);
    overflow: hidden;
}

.meal-item {
    display: flex;
    align-items: center;
    padding: 22rpx 24rpx;
    border-bottom: 2rpx solid rgba(100, 68, 22, 0.05);
}

.meal-item:last-child {
    border-bottom: none;
}

.meal-item-editing {
    background: rgba(230, 174, 26, 0.08);
}

.meal-item-main {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
}

.meal-item-name-row {
    display: flex;
    align-items: baseline;
}

.meal-item-name {
    max-width: 300rpx;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: #432b1d;
    font-size: 28rpx;
    font-weight: 600;
}

.meal-item-qty {
    flex-shrink: 0;
    margin-left: 12rpx;
    color: #a29180;
    font-size: 24rpx;
}

.meal-item-note {
    margin-top: 6rpx;
    color: #a0a5ad;
    font-size: 22rpx;
}

.meal-item-kcal {
    flex-shrink: 0;
    margin-left: 16rpx;
    color: #c2511d;
    font-size: 26rpx;
    font-weight: 600;
}

.meal-item-del {
    flex-shrink: 0;
    margin-left: 16rpx;
    padding: 14rpx 12rpx;
    color: #e5484d;
    font-size: 24rpx;
}

.meal-sum {
    margin-top: 16rpx;
    padding: 22rpx 24rpx;
    border-radius: 20rpx;
    background: rgba(230, 174, 26, 0.1);
    border: 2rpx solid rgba(230, 174, 26, 0.22);
}

.meal-sum-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
}

.meal-sum-label {
    color: #c2511d;
    font-size: 26rpx;
    font-weight: 600;
}

.meal-sum-kcal {
    color: #a76b11;
    font-size: 34rpx;
    font-weight: 600;
}

.meal-sum-macro {
    display: block;
    margin-top: 8rpx;
    color: #8a6a5c;
    font-size: 24rpx;
}

.meal-actions {
    display: flex;
    align-items: center;
    margin-top: 8rpx;
}

.meal-add-btn {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    height: 88rpx;
    border-radius: 16rpx;
    background: rgba(230, 174, 26, 0.12);
    border: 2rpx dashed rgba(230, 174, 26, 0.45);
    color: #a76b11;
    font-size: 28rpx;
    font-weight: 600;
}

.meal-add-btn-hover {
    background: rgba(230, 174, 26, 0.22);
}

.meal-cancel-edit {
    display: flex;
    align-items: center;
    height: 88rpx;
    margin-left: 24rpx;
    padding: 0 8rpx;
    color: #a29180;
    font-size: 26rpx;
    text-decoration: underline;
}

/* ---------- 记录时间 ---------- */
.time-group {
    margin-top: 24rpx;
}

.time-row {
    display: flex;
    align-items: center;
}

.time-trigger {
    display: flex;
    align-items: center;
    height: 68rpx;
    padding: 0 24rpx;
    border-radius: 16rpx;
    background: rgba(255, 255, 255, 0.6);
    border: 2rpx solid rgba(255, 255, 255, 0.7);
}

.time-trigger-hover {
    opacity: 0.72;
}

.time-icon {
    margin-right: 10rpx;
    font-size: 26rpx;
}

.time-text {
    color: #432b1d;
    font-size: 26rpx;
    font-weight: 600;
}

.time-caret {
    margin-left: 10rpx;
    color: #a29180;
    font-size: 22rpx;
}

.time-reset {
    margin-left: 20rpx;
    padding: 12rpx 8rpx;
    color: #a76b11;
    font-size: 24rpx;
    line-height: 1;
    text-decoration: underline;
}

/* ---------- 语音便签 ---------- */
.voice-chip {
    margin-top: 24rpx;
    padding: 20rpx 24rpx;
    border-radius: 20rpx;
    background: rgba(255, 255, 255, 0.6);
    border: 2rpx solid rgba(255, 214, 77, 0.35);
    display: flex;
    align-items: center;
}

.voice-chip-icon {
    font-size: 36rpx;
    margin-right: 16rpx;
}

.voice-chip-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.voice-chip-title {
    color: #432b1d;
    font-size: 26rpx;
    font-weight: 600;
}

.voice-chip-sub {
    margin-top: 4rpx;
    color: #a29180;
    font-size: 22rpx;
}

.voice-chip-play {
    padding: 14rpx 16rpx;
    color: #2b7fc0;
    font-size: 24rpx;
    font-weight: 600;
    line-height: 1;
}

.voice-chip-remove {
    padding: 14rpx 4rpx 14rpx 16rpx;
    color: #a29180;
    font-size: 24rpx;
    line-height: 1;
}

/* ---------- 数字展示框（替代系统键盘的 input） ---------- */
.field-display {
    box-sizing: border-box;
    width: 100%;
    min-height: 84rpx;
    padding: 18rpx 24rpx;
    border-radius: 16rpx;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(20rpx);
    -webkit-backdrop-filter: blur(20rpx);
    border: 2rpx solid rgba(255, 255, 255, 0.7);
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: border-color 160ms ease, background-color 160ms ease;
}

.field-display-active {
    border-color: #ffd555;
    background: rgba(255, 236, 226, 0.7);
}

.field-display-value {
    color: #432b1d;
    font-size: 28rpx;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.field-display-empty {
    color: #a8acb3;
    font-weight: 400;
}

.field-display-icon {
    margin-left: 12rpx;
    color: #b3b8bf;
    font-size: 24rpx;
    flex-shrink: 0;
}

.qty-display {
    width: 140rpx;
    flex: none;
    justify-content: center;
}

.qty-display .field-display-icon {
    display: none;
}

/* ---------- 功能入口：动手记 / 拍照记 ---------- */
.entry-duo {
    display: flex;
    gap: 20rpx;
    margin-bottom: 24rpx;
}

.entry-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 26rpx 24rpx;
    border-radius: 24rpx;
    background: rgba(255, 255, 255, 0.62);
    backdrop-filter: blur(14rpx);
    -webkit-backdrop-filter: blur(14rpx);
    border: 2rpx solid rgba(255, 255, 255, 0.65);
    box-shadow: 0 8rpx 24rpx rgba(230, 174, 26, 0.08);
}

.entry-btn-key {
    background: linear-gradient(135deg, rgba(255, 244, 236, 0.9), rgba(255, 231, 216, 0.8));
    border-color: rgba(255, 214, 77, 0.35);
}

.entry-btn-cam {
    background: linear-gradient(135deg, rgba(233, 245, 255, 0.9), rgba(214, 234, 252, 0.8));
    border-color: rgba(91, 156, 226, 0.35);
}

.entry-btn-hover {
    opacity: 0.78;
    transform: scale(0.985);
}

.entry-icon {
    font-size: 48rpx;
    margin-right: 18rpx;
}

.entry-title {
    color: #432b1d;
    font-size: 31rpx;
    font-weight: 700;
}

/* ---------- 键盘面板（动手记 / 识别结果共用，键盘常驻） ---------- */
.sheet-mask {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 54;
    background: rgba(100, 68, 22, 0.4);
    animation: sheet-fade 200ms ease-out;
}

@keyframes sheet-fade {
    0% { opacity: 0; }
    100% { opacity: 1; }
}

.keypad-panel {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 55;
    display: flex;
    flex-direction: column;
    max-height: 88vh;
    border-radius: 32rpx 32rpx 0 0;
    background: rgba(252, 248, 244, 0.98);
    box-shadow: 0 -12rpx 48rpx rgba(100, 68, 22, 0.16);
    animation: sheet-up 240ms ease-out;
}

@keyframes sheet-up {
    0% { transform: translateY(30%); opacity: 0.5; }
    100% { transform: translateY(0); opacity: 1; }
}

.kp-scroll {
    flex: 1;
    min-height: 0;
    box-sizing: border-box;
    padding: 14rpx 30rpx 0;
}

.kp-head {
    display: flex;
    align-items: center;
}

.kp-time {
    display: flex;
    align-items: center;
    height: 62rpx;
    padding: 0 22rpx;
    border-radius: 999rpx;
    background: #ffffff;
    border: 2rpx solid rgba(100, 68, 22, 0.06);
}

.kp-time-hover {
    opacity: 0.7;
}

.kp-time-text {
    color: #432b1d;
    font-size: 25rpx;
    font-weight: 600;
}

.kp-close {
    margin-left: auto;
    padding: 10rpx 4rpx 10rpx 24rpx;
    color: #a76b11;
    font-size: 26rpx;
    font-weight: 600;
    line-height: 1;
}

.sheet-photo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12rpx;
}

.sheet-photo-small {
    display: block;
    width: 240rpx;
    max-width: calc(100% - 68rpx);
    height: 140rpx;
    border-radius: 16rpx;
    flex: none;
}

.kp-namerow {
    display: flex;
    align-items: center;
    margin-top: 16rpx;
}

.kp-name-wrap {
    position: relative;
    flex: 1;
    min-width: 0;
}

.kp-name {
    box-sizing: border-box;
    width: 100%;
    min-height: 82rpx;
    padding: 16rpx 58rpx 16rpx 24rpx;
    border-radius: 16rpx;
    background: #ffffff;
    border: 2rpx solid rgba(100, 68, 22, 0.06);
    color: #432b1d;
    font-size: 28rpx;
}

/* 名称右侧的下拉箭头：点开常见食物列表 */
.kp-name-arrow {
    position: absolute;
    top: 50%;
    right: 4rpx;
    padding: 16rpx 18rpx;
    transform: translateY(-50%);
    color: #a29180;
    font-size: 22rpx;
    line-height: 1;
}

.kp-name-arrow-open {
    color: #a76b11;
    transform: translateY(-50%) rotate(180deg);
}

/* 备注按钮：和名称同一行，点开弹窗写；固定宽度，别随文字伸缩 */
.kp-note-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    flex: none;
    width: 224rpx;
    height: 82rpx;
    margin-left: 12rpx;
    padding: 0;
    border-radius: 16rpx;
    background: rgba(255, 255, 255, 0.7);
    border: 2rpx solid rgba(100, 68, 22, 0.06);
}

.kp-note-btn-text {
    color: #86725e;
    font-size: 24rpx;
    line-height: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.kp-note-btn-on {
    background: #fff1e8;
    border-color: rgba(230, 174, 26, 0.35);
}

.kp-note-btn-on .kp-note-btn-text {
    color: #c2571f;
    font-weight: 600;
}

.kp-btn-hover {
    opacity: 0.7;
}

/* 常见食物下拉：fixed 悬浮层，挂在页面根节点（面板 scroll-view 会裁剪绝对定位子元素，
   小屏上菜单只能露两三行）。位置/宽度/高度由 JS 量出后内联传入。
   行高锁死 88rpx，最多 5 行，超出在层内滚动 */
.kp-menu {
    position: fixed;
    z-index: 61;
    box-sizing: border-box;
    border-radius: 16rpx;
    background: #ffffff;
    border: 2rpx solid rgba(100, 68, 22, 0.06);
    box-shadow: 0 16rpx 40rpx rgba(100, 68, 22, 0.18);
}

/* 下拉打开时的透明蒙层：点外面收起，也挡住下面的误触 */
.kp-menu-mask {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 60;
}

.kp-menu-item {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    height: 88rpx;
    padding: 0 22rpx;
    border-bottom: 2rpx solid rgba(100, 68, 22, 0.05);
}

.kp-menu-item:last-child {
    border-bottom: none;
}

.kp-menu-name {
    flex: none;
    max-width: 45%;
    color: #432b1d;
    font-size: 27rpx;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.kp-menu-meta {
    flex: 1;
    margin-left: 12rpx;
    color: #a29180;
    font-size: 20rpx;
    text-align: right;
    white-space: nowrap;
}

.kp-menu-hot {
    flex: none;
    margin-left: 10rpx;
    padding: 2rpx 10rpx;
    border-radius: 999rpx;
    background: #ffefe7;
    color: #c2571f;
    font-size: 18rpx;
    line-height: 1.6;
}

.kp-menu-tip {
    display: block;
    padding: 20rpx 24rpx;
    color: #a29180;
    font-size: 24rpx;
}

.kp-suggestions {
    margin-top: 10rpx;
}

.kp-chips {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12rpx;
    margin-top: 16rpx;
}

.kp-chip {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 14rpx 4rpx;
    border-radius: 16rpx;
    background: #ffffff;
    border: 3rpx solid rgba(100, 68, 22, 0.04);
    min-width: 0;
}

.kp-chip-on {
    background: #ffefe7;
    border-color: #ffd555;
}

.kp-chip-label {
    color: #a29180;
    font-size: 20rpx;
    line-height: 1.2;
}

.kp-chip-on .kp-chip-label {
    color: #c2571f;
    font-weight: 600;
}

.kp-chip-value {
    max-width: 100%;
    margin-top: 4rpx;
    color: #432b1d;
    font-size: 26rpx;
    font-weight: 700;
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* 备注弹窗 */
.note-mask {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 60;
    background: rgba(20, 22, 26, 0.45);
}

.note-card {
    position: fixed;
    top: 50%;
    left: 50%;
    z-index: 61;
    box-sizing: border-box;
    width: 600rpx;
    padding: 30rpx 28rpx 24rpx;
    transform: translate(-50%, -50%);
    border-radius: 22rpx;
    background: #fffaf6;
    box-shadow: 0 24rpx 60rpx rgba(100, 68, 22, 0.22);
}

.note-title {
    display: block;
    color: #432b1d;
    font-size: 30rpx;
    font-weight: 700;
}

.note-input {
    box-sizing: border-box;
    width: 100%;
    height: 168rpx;
    margin-top: 18rpx;
    padding: 16rpx 20rpx;
    border-radius: 14rpx;
    background: #ffffff;
    border: 2rpx solid rgba(100, 68, 22, 0.08);
    color: #432b1d;
    font-size: 26rpx;
    line-height: 1.5;
}

.note-actions {
    display: flex;
    justify-content: space-between;
    margin-top: 24rpx;
}

.note-btn {
    box-sizing: border-box;
    width: 250rpx;
    height: 78rpx;
    margin: 0;
    padding: 0;
    border-radius: 999rpx;
    background: #f2f3f5;
    color: #4e5561;
    font-size: 27rpx;
    font-weight: 600;
    line-height: 78rpx;
}

.note-btn-primary {
    background: #a76b11;
    color: #ffffff;
}

.kp-grid {
    display: flex;
    flex-direction: column;
    gap: 12rpx;
    padding: 16rpx 30rpx 0;
}

.kp-row { display:flex; gap:12rpx; }
.kp-number-row { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); flex:7; min-width:0; gap:12rpx; }
.kp-function-row { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); flex:3; min-width:0; gap:12rpx; }
.kp-bottom-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 14fr)) repeat(2, minmax(0, 9fr));
}
.kp-key-zero, .kp-key-equals { grid-column: span 2; }

.kp-key {
    height: 80rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 16rpx;
    background: #ffffff;
    border: 2rpx solid rgba(100, 68, 22, 0.06);
    color: #432b1d;
    font-size: 36rpx;
    font-weight: 600;
    line-height: 1;
}

.kp-key-hover {
    background: #ffefe7;
}

.kp-key-fn {
    color: #86725e;
    font-size: 29rpx;
    background: rgba(100, 68, 22, 0.05);
}

.kp-key-next {
    grid-column: span 2;
    color: #2b7fc0;
    font-size: 29rpx;
    background: rgba(91, 156, 226, 0.1);
    border-color: rgba(91, 156, 226, 0.22);
}

.kp-bar {
    display: flex;
    align-items: center;
    padding: 16rpx 30rpx 0;
}

.kp-unit {
    flex: none;
}

.kp-add {
    flex: 1;
    margin-left: 16rpx;
    background: linear-gradient(135deg, #ffd555, #a76b11);
    border: none;
    color: #ffffff;
    box-shadow: 0 8rpx 22rpx rgba(230, 174, 26, 0.32);
}

.kp-add-hover {
    opacity: 0.85;
}

.kp-foot {
    display: flex;
    align-items: center;
    min-height: 48rpx;
    padding: 6rpx 30rpx calc(14rpx + env(safe-area-inset-bottom));
}

.kp-cancel {
    color: #a29180;
    font-size: 24rpx;
    text-decoration: underline;
}

.kp-error {
    margin-left: auto;
    color: #d54941;
    font-size: 23rpx;
}

/* ---------- AI 识别中 ---------- */
.recognize-overlay {
    position: fixed;
    inset: 0;
    z-index: 70;
    overflow-y: auto;
    background: #fff8eb;
    color: #432719;
}
.recognize-card {
    box-sizing: border-box;
    max-width: 780rpx;
    min-height: 100%;
    margin: auto;
    padding: 22rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
    text-align: center;
}
.scan-brand, .scan-footer { display: flex; align-items: center; justify-content: center; gap: 16rpx; }
.scan-brand { font-size: 30rpx; font-weight: 700; }
.scan-brand image { width: 60rpx; height: 60rpx; border-radius: 14rpx; }
.scan-title { display: block; margin: 24rpx 0 12rpx; font-size: 42rpx; font-weight: 700; }
.scan-pill { display: inline-block; padding: 10rpx 20rpx; border-radius: 40rpx; background: #ffedbe; color: #583715; font-size: 24rpx; }
.scan-frame { position: relative; overflow: hidden; border-radius: 32rpx; margin: 18rpx 0; height: 42vw; max-height: 360rpx; background: #eee7de; }
.recognize-photo { width: 100%; height: 100%; display: block; }
.scan-corner { position: absolute; width: 32rpx; height: 32rpx; border: 0 solid #fff4b3; }
.scan-tl { top: 20rpx; left: 20rpx; border-width: 4rpx 0 0 4rpx; border-top-left-radius: 14rpx; }
.scan-tr { top: 20rpx; right: 20rpx; border-width: 4rpx 4rpx 0 0; border-top-right-radius: 14rpx; }
.scan-bl { bottom: 20rpx; left: 20rpx; border-width: 0 0 4rpx 4rpx; border-bottom-left-radius: 14rpx; }
.scan-br { bottom: 20rpx; right: 20rpx; border-width: 0 4rpx 4rpx 0; border-bottom-right-radius: 14rpx; }
.scan-beam { position: absolute; left: 0; right: 0; height: 4rpx; background: #fff4a0; box-shadow: 0 0 24rpx 7rpx #ffcc5377; animation: photo-sweep 2s ease-in-out infinite alternate; }
@keyframes photo-sweep { from { top: 12%; } to { top: 88%; } }
.scan-step { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; text-align: left; background: #fffdf8; border-radius: 24rpx; padding: 13rpx 22rpx; margin-bottom: 10rpx; font-size: 27rpx; font-weight: 600; }
.scan-active { background: #fff0c9; }
.scan-detail { display: block; color: #785f4b; font-size: 22rpx; font-weight: 400; }
.recognize-spinner { flex: none; width: 30rpx; height: 30rpx; border: 5rpx solid #ffe4a0; border-top-color: #bd7b00; border-radius: 50%; animation: recognize-spin 800ms linear infinite; }
@keyframes recognize-spin { to { transform: rotate(360deg); } }
.scan-footer image { width: 146rpx; height: 132rpx; border-radius: 28rpx; }
.ui-theme-dark .recognize-overlay { background: #20242d; color: #fff4e4; }
.ui-theme-dark .scan-step { background: #2e3440; }
.ui-theme-dark .scan-active { background: #473a29; }
.ui-theme-dark .scan-detail { color: #ddd0c0; }
@media (prefers-reduced-motion: reduce) {
    .scan-beam, .recognize-spinner { animation: none; }
    .scan-beam { top: 50%; }
}
