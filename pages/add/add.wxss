.catalog-sheet {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 51; box-sizing: border-box;
  animation: catalog-sheet-enter 240ms ease-out both;
  max-height: 78vh; overflow-y: auto; background: #fffdf8; border-radius: 32rpx 32rpx 0 0;
  padding: 12rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}
.catalog-sheet-grip { width: 60rpx; height: 7rpx; border-radius: 8rpx; margin: 0 auto 18rpx; background: #d5c8b8; }
.catalog-sheet-close { margin-left: auto; font-size: 34rpx; padding: 10rpx 16rpx; }
.catalog-breakdown { margin-top: 12rpx; border-radius: 16rpx; padding: 12rpx 16rpx; background: rgba(249,235,210,.48); font-size: 23rpx; }
.catalog-breakdown .portion-weight { margin-top: 8rpx; }
.ui-theme-dark .catalog-category, .ui-theme-dark .catalog-tile { background: #35363e; }
.ui-theme-dark .catalog-selected, .ui-theme-dark .catalog-new { background: #e2bd58; }
.ui-theme-dark .catalog-popover, .ui-theme-dark .catalog-sheet { background: #282b33; border-color: #494452; }
.ui-theme-dark .catalog-pointer { border-color: #494452; }
.ui-theme-dark .catalog-breakdown { background: #39352f; }
.ui-theme-dark .catalog-scroll-hint { color: #cbbb9f; }

.portion-basis-bar { display: flex; margin: 10rpx 0; min-height: 56rpx; border: 1rpx solid #eab700; border-radius: 30rpx; background: #ffe68c; color: #382508; overflow: hidden; }
.portion-basis-value { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center; gap: 8rpx; font-size: 24rpx; }
.portion-basis-value input { width: 144rpx; min-height: 50rpx; text-align: center; font-size: 28rpx; font-weight: 500; color: #382508; }
.ui-theme-dark .portion-basis-value input { color: #382508; }
.add-page .meal-list-card { padding: 18rpx 20rpx 8rpx; border: 1rpx solid rgba(255,255,255,.75); border-radius: 24rpx; background: rgba(255,255,255,.42); }
.add-page .meal-list-card .meal-list-head { margin: 0 0 8rpx; gap: 8rpx; }
.add-page .meal-list-card .meal-list { margin: 0; border: 0; background: transparent; }
.add-page .meal-list-card .meal-clear { font-size: 25rpx; }
.ui-theme-dark.add-page .meal-list-card { background: rgba(54,61,74,.36); border-color: rgba(255,255,255,.065); }
.ui-theme-dark.add-page .meal-list-card .meal-list { background: transparent; }
.portion-basis-save { flex: 0 0 20%; display: flex; justify-content: center; align-items: center; border-left: 1rpx solid #eab700; background: #ffda59; font-size: 24rpx; font-weight: 700; }

@keyframes catalog-popover-enter {
  from { opacity: 0; transform: translateY(-10rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes catalog-mask-enter {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes catalog-sheet-enter {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
@media (prefers-reduced-motion: reduce) {
  .catalog-popover, .catalog-sheet-mask, .catalog-sheet { animation: none; }
}

.portion-picker { position: relative; }
.portion-dropdown { position: absolute; z-index: 25; top: 76rpx; left: 0; right: 90rpx; margin-top: 8rpx; padding: 8rpx 16rpx 0; overflow: hidden; box-shadow: 0 12rpx 30rpx rgba(85, 55, 22, .15); transform-origin: top center; animation: portion-dropdown-in .22s ease-out; }
.portion-results { max-height: 440rpx; }
.portion-dropdown .catalog-manual { border-top: 1rpx solid rgba(170,130,70,.18); padding: 20rpx; }
@keyframes portion-dropdown-in { from { opacity: 0; transform: translateY(-12rpx) scaleY(.96); } to { opacity: 1; transform: translateY(0) scaleY(1); } }

.catalog-category .catalog-icon-mine { transform: scale(1.5); }

.catalog-popover-first { top: 98rpx; }
.catalog-popover-second { top: 196rpx; }

.catalog-pages { height: 210rpx; width: 100%; margin-top: 18rpx; white-space: nowrap; }
.catalog-pages-track { display: flex; width: 200%; height: 100%; }
.catalog-page { flex: 0 0 50%; min-width: 0; height: 100%; }
.catalog-pages .catalog-grid { margin-top: 0; }

.catalog-overlay-anchor { position: relative; z-index: 20; }
.catalog-overlay-anchor .catalog-popover-first { top: -112rpx; }
.catalog-overlay-anchor .catalog-popover-second { top: -14rpx; }

.kp-category-head { position: relative; justify-content: flex-start; min-height: 56rpx; }
.kp-category-head .catalog-form-category { text-align: left; padding: 10rpx 0; font-size: 26rpx; font-weight: 600; }
.kp-category-head .kp-close { position: absolute; right: 0; top: 50%; transform: translateY(-50%); }

.photo-choice-mask { position: fixed; inset: 0; z-index: 200; background: rgba(42,32,23,.42); }
.photo-choice { position: fixed; z-index: 201; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 84%; max-width: 600rpx; padding: 24rpx 28rpx 28rpx; border: 1rpx solid rgba(255,255,255,.8); border-radius: 32rpx; background: rgba(255,250,240,.92); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); box-shadow: 0 18rpx 60rpx rgba(73,48,30,.18); color: #49301e; box-sizing: border-box; }
.photo-choice-grip { width: 60rpx; height: 7rpx; margin: 0 auto 18rpx; background: #d8c8b4; border-radius: 8rpx; }
.photo-choice-title { display: block; text-align: center; font-weight: 700; font-size: 30rpx; padding: 8rpx 0 18rpx; }
.photo-choice-option, .photo-choice-cancel { display: flex; align-items: center; justify-content: center; min-height: 86rpx; border-radius: 22rpx; font-size: 28rpx; font-weight: 600; }
.photo-choice-option { background: #fff1ce; margin-bottom: 12rpx; }
.photo-choice-cancel { margin-top: 16rpx; background: #fff; color: #795e48; }
.ui-theme-dark .photo-choice { background: rgba(40,43,51,.93); border-color: rgba(255,255,255,.12); color: #f4e9d8; }
.ui-theme-dark .photo-choice-option { background: #49402f; }
.ui-theme-dark .photo-choice-cancel { background: #393b42; color: #e2d4c3; }

.add-page .kp-namerow .kp-inline-unit { background: transparent; border-color: transparent; }
.add-page .kp-quantity-value, .ui-theme-dark.add-page .kp-quantity-value.kp-chip-on { background: transparent; color: inherit; }
.kp-unit-choice { align-self: stretch; background: rgba(255,227,150,.65); border-radius: 14rpx; }
.ui-theme-dark .kp-unit-choice { background: rgba(202,165,75,.28); }
.kp-caret { width: 2rpx; height: 28rpx; margin-left: 3rpx; background: currentColor; animation: kp-caret-blink 1s steps(2, start) infinite; }
@keyframes kp-caret-blink { 50% { opacity: 0; } }
.search-voice { flex: none; width: 48rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; color: #8e653b; font-size: 26rpx; }
.search-voice-active { color: #c45b40; }
.search-recording { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 20rpx; color: #8e653b; font-size: 23rpx; }
.ui-theme-dark .search-recording, .ui-theme-dark .search-voice { color: #e6ce96; }
@media (prefers-reduced-motion: reduce) { .kp-caret { animation: none; } }

.search-voice-mic { position: relative; width: 14rpx; height: 23rpx; border: 3rpx solid currentColor; border-radius: 9rpx; }
.search-voice-mic::before { content: ""; position: absolute; width: 24rpx; height: 17rpx; left: -8rpx; top: 12rpx; border: 3rpx solid currentColor; border-top: 0; border-radius: 0 0 16rpx 16rpx; }
.search-voice-mic::after { content: ""; position: absolute; width: 3rpx; height: 7rpx; background: currentColor; left: 5rpx; top: 31rpx; }

/* Search controls: centered icons and a quiet recording indicator. */
.portion-search .search-magnifier{position:relative;box-sizing:border-box;flex:none;width:25rpx;height:25rpx;margin-right:3rpx;padding:0;border:3rpx solid #876f55;border-radius:50%}
.search-magnifier::after{content:"";position:absolute;width:11rpx;height:3rpx;right:-8rpx;bottom:-4rpx;border-radius:2rpx;background:#876f55;transform:rotate(45deg);transform-origin:left center}
.portion-search .search-voice{position:relative;box-sizing:border-box;flex:none;width:68rpx;height:56rpx;padding:0;border-radius:50%;color:#e4a82f}
.search-voice-mic{box-sizing:border-box;flex:none;width:16rpx;height:24rpx;margin-top:-7rpx;border:0;border-radius:9rpx;background:linear-gradient(180deg,#ffdc75,#e9aa30)}
.search-voice-mic::before{box-sizing:border-box;width:26rpx;height:18rpx;left:50%;top:11rpx;transform:translateX(-50%);border:2.5rpx solid currentColor;border-top:0;border-radius:0 0 14rpx 14rpx}
.search-voice-mic::after{width:2.5rpx;height:8rpx;left:50%;top:27rpx;transform:translateX(-50%)}
.portion-search .search-voice-active{color:#e4a82f;background:transparent;animation:none}
.search-mic-wave{position:absolute;top:calc(50% - 2rpx);display:flex;align-items:center;gap:4rpx;height:26rpx;transform:translateY(-50%);pointer-events:none}
.search-mic-wave-left{left:0}.search-mic-wave-right{right:0}
.search-mic-bar{width:6rpx;height:14rpx;border-radius:3rpx;background:linear-gradient(180deg,#ffd05a,#efab2c);transform-origin:center;animation:search-wave .9s ease-in-out infinite alternate}
.search-mic-wave-left .search-mic-bar:last-child,.search-mic-wave-right .search-mic-bar:first-child{height:24rpx;animation-delay:.18s}
.search-mic-wave-left .search-mic-bar:first-child,.search-mic-wave-right .search-mic-bar:last-child{animation-delay:.36s}
@keyframes search-wave{from{transform:scaleY(.35)}to{transform:scaleY(1)}}
.ui-theme-dark .search-mic-bar{background:linear-gradient(180deg,#ffe08a,#f5bd45)}
.ui-theme-dark .portion-search .search-magnifier{border-color:#ddc798}.ui-theme-dark .search-magnifier::after{background:#ddc798}
.ui-theme-dark .portion-search .search-voice,.ui-theme-dark .portion-search .search-voice-active{color:#ffd17a;background:transparent}
@media (prefers-reduced-motion:reduce){.search-mic-bar{animation:none}}
