<view class="prefs-page {{uiThemeClass}}">
  <view class="prefs-heading"><text>按你的习惯，记录每一天。</text></view>
  <view class="prefs-card theme-card"><text class="prefs-title">主题风格</text><view class="theme-choices"><view class="theme-choice {{uiTheme === 'simple' ? 'theme-selected' : ''}}" data-key="simple" bindtap="handleTheme" aria-role="button" aria-label="选择简约"><view class="theme-preview preview-simple"><view class="preview-header"></view><view class="preview-tile"></view><view class="preview-tile"></view></view><view class="theme-name"><text>简约</text><text class="theme-check">{{uiTheme === 'simple' ? '✓' : ''}}</text></view><text class="theme-description">清晰温暖，简洁耐看</text></view><view class="theme-choice {{uiTheme === 'light' ? 'theme-selected' : ''}}" data-key="light" bindtap="handleTheme" aria-role="button" aria-label="选择轻透"><view class="theme-preview preview-light"><view class="preview-header"></view><view class="preview-tile"></view><view class="preview-tile"></view></view><view class="theme-name"><text>轻透</text><text class="theme-check">{{uiTheme === 'light' ? '✓' : ''}}</text></view><text class="theme-description">柔和透光，轻盈通透</text></view><view class="theme-choice {{uiTheme === 'dark' ? 'theme-selected' : ''}}" data-key="dark" bindtap="handleTheme"><view class="theme-preview preview-dark"><view class="preview-header"></view><view class="preview-tile"></view><view class="preview-tile"></view></view><view class="theme-name"><text>深色</text><text class="theme-check">{{uiTheme === 'dark' ? '✓' : ''}}</text></view><text class="theme-description">低亮柔和，夜间舒适</text></view><view class="theme-choice {{uiTheme === 'system' ? 'theme-selected' : ''}}" data-key="system" bindtap="handleTheme"><view class="theme-preview preview-system"><view class="preview-header"></view><view class="preview-tile"></view><view class="preview-tile"></view></view><view class="theme-name"><text>跟随系统</text><text class="theme-check">{{uiTheme === 'system' ? '✓' : ''}}</text></view><text class="theme-description">浅色用简约，深色用深色</text></view></view><view class="glass-toggle-row"><text>导航栏玻璃效果</text><switch checked="{{navGlass}}" color="#dfb345" bindchange="handleNavGlass" /></view></view>
  <view class="prefs-card"><view class="prefs-title-row"><text class="prefs-title">导航栏设置</text></view><text class="prefs-sub">透明度数值越小越透明；关闭玻璃效果后使用实色导航栏。</text><view class="nav-preview-scene"><view class="nav-preview-glass" style="background:rgba({{uiResolvedTheme === 'dark' ? '29,34,44' : '255,253,245'}},{{navGlass ? navOpacity / 100 : 1}});backdrop-filter:{{navGlass ? 'blur(' + navBlur + 'px) saturate(145%)' : 'none'}};-webkit-backdrop-filter:{{navGlass ? 'blur(' + navBlur + 'px) saturate(145%)' : 'none'}}"><text>今日</text><text>趋势</text><text>我的</text></view></view><view class="blur-heading"><text>透明效果</text><text>{{navOpacity}}%</text></view><slider min="0" max="100" step="1" value="{{navOpacity}}" disabled="{{!navGlass}}" bindchanging="handleNavOpacity" bindchange="saveNavOpacity" activeColor="#dfb345" backgroundColor="#d6cebd" block-size="22" /><view class="transparency-labels"><text>更透明</text><text>不透明</text></view><view class="blur-heading"><text>毛玻璃效果</text><text>{{navBlur}}</text></view><slider min="0" max="40" step="1" value="{{navBlur}}" disabled="{{!navGlass}}" bindchanging="handleNavBlur" bindchange="saveNavBlur" activeColor="#dfb345" backgroundColor="#d6cebd" block-size="22" /><view class="transparency-labels"><text>清晰</text><text>柔和模糊</text></view></view>
  <view class="prefs-card"><text class="prefs-title">显示单位</text><view class="pref-row"><view class="pref-icon"><image src="/assets/icons/menu/flame.svg" mode="aspectFit" /></view><text class="pref-label">热量单位</text><view class="pref-segments"><view class="pref-choice {{energyUnit === 'kcal' ? 'pref-selected' : ''}}" data-key="kcal" bindtap="handleEnergy">kcal</view><view class="pref-choice {{energyUnit === 'kj' ? 'pref-selected' : ''}}" data-key="kj" bindtap="handleEnergy">kJ</view></view></view><view class="pref-row"><view class="pref-icon"><image src="/assets/icons/menu/body.svg" mode="aspectFit" /></view><text class="pref-label">体重单位</text><view class="pref-segments"><view class="pref-choice {{weightUnit === 'kg' ? 'pref-selected' : ''}}" data-key="kg" bindtap="handleWeight">kg</view><view class="pref-choice {{weightUnit === 'jin' ? 'pref-selected' : ''}}" data-key="jin" bindtap="handleWeight">斤</view><view class="pref-choice {{weightUnit === 'lb' ? 'pref-selected' : ''}}" data-key="lb" bindtap="handleWeight">lb</view></view></view><text class="prefs-hint">切换单位只影响显示，不改变原始记录。</text></view>
  <view class="prefs-card"><view class="prefs-title-row"><text class="prefs-title">饮水快捷量</text><view class="restore-default" bindtap="handleQuickRestore">↻ 恢复默认</view></view><text class="prefs-sub">首页三个快捷按钮</text><view class="quick-fields"><view class="quick-field" wx:for="{{waterDrafts}}" wx:key="index"><input type="number" value="{{item}}" maxlength="4" data-index="{{index}}" bindinput="handleQuickInput" bindblur="commitQuick" bindconfirm="commitQuick" /><text>ml</text><image src="/assets/icons/line-pencil.png" mode="aspectFit" /></view></view><text class="prefs-error" wx:if="{{quickError}}">{{quickError}}</text></view>
  <view class="prefs-card"><text class="prefs-title">记录习惯</text><view class="pref-row"><view class="pref-icon"><image src="/assets/icons/menu/file.svg" mode="aspectFit" /></view><text class="pref-label">保存一餐后</text><view class="pref-segments after-segments"><view class="pref-choice {{afterSave === 'back' ? 'pref-selected' : ''}}" data-key="back" bindtap="handleAfterSave">返回首页</view><view class="pref-choice {{afterSave === 'stay' ? 'pref-selected' : ''}}" data-key="stay" bindtap="handleAfterSave">留在记一餐</view></view></view><text class="prefs-hint">{{afterSaveHint}}</text></view>
  <view class="prefs-card"><text class="prefs-title">功能开关</text><view class="pref-row display-row"><view class="pref-icon"><image src="/assets/icons/menu/play.svg" mode="aspectFit" /></view><view class="display-copy"><text>蛋仔动画</text><text>生动陪伴你的每一天</text></view><switch checked="{{homeDisplay.mascotAnimation}}" color="#ffd13e" data-key="mascotAnimation" bindchange="handleDisplay" /></view><view class="pref-row display-row"><view class="pref-icon"><image src="/assets/icons/menu/book.svg" mode="aspectFit" /></view><view class="display-copy"><text>饮食科普自动轮播</text><text>自动切换科普内容</text></view><switch checked="{{homeDisplay.scienceAutoplay}}" color="#ffd13e" data-key="scienceAutoplay" bindchange="handleDisplay" /></view><view class="pref-row display-row"><view class="pref-icon"><image src="/assets/icons/menu/file.svg" mode="aspectFit" /></view><view class="display-copy"><text>自动检查更新</text><text>打开 App 时检查，有新版时提示</text></view><switch checked="{{homeDisplay.autoUpdate}}" color="#ffd13e" data-key="autoUpdate" bindchange="handleDisplay" /></view></view>
  <text class="prefs-footer">选择后立即生效。</text>
</view>
