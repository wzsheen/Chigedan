.prefs-page{box-sizing:border-box;min-height:100vh;padding:24rpx 28rpx calc(42rpx + env(safe-area-inset-bottom));color:#513a26}.prefs-heading{font-size:26rpx;line-height:1.7;color:#8b765e;margin:4rpx 8rpx 24rpx}.prefs-card{padding:24rpx 24rpx 22rpx;border-radius:30rpx;background:rgba(255,254,248,.45);border:1rpx solid rgba(255,255,255,.94);box-shadow:inset 0 1rpx 0 #fff,0 7rpx 24rpx rgba(128,95,30,.025);margin-bottom:22rpx}.prefs-title{display:block;font-size:29rpx;font-weight:600;line-height:1.5;margin-bottom:12rpx}.pref-row{display:flex;align-items:center;min-height:82rpx}.pref-icon{flex:none;width:50rpx;height:50rpx;display:flex;align-items:center;justify-content:center;background:rgba(255,234,158,.44);border-radius:16rpx;margin-right:14rpx}.pref-icon image{width:35rpx;height:35rpx}.pref-label{font-size:25rpx;white-space:nowrap;margin-right:18rpx}.pref-segments{display:flex;flex:1;min-width:0;background:rgba(239,231,212,.38);padding:3rpx;border-radius:21rpx;border:1rpx solid rgba(255,255,255,.9)}.pref-choice{box-sizing:border-box;flex:1;min-width:0;padding:14rpx 3rpx;font-size:25rpx;color:#9b8569;text-align:center;border:1rpx solid transparent;border-radius:18rpx;white-space:nowrap}.pref-selected{background:rgba(255,232,143,.62);border-color:#ecc45f;color:#62451d;box-shadow:inset 0 1rpx 0 rgba(255,255,255,.9)}.after-segments .pref-choice{font-size:22rpx;padding-left:3rpx;padding-right:3rpx}.prefs-hint{display:block;font-size:21rpx;color:#a38f74;line-height:1.7;margin:12rpx 4rpx 0}.prefs-title-row{display:flex;align-items:center;justify-content:space-between}.prefs-title-row .prefs-title{margin-bottom:0}.restore-default{font-size:21rpx;color:#a78a43;padding:8rpx 0 8rpx 14rpx}.prefs-sub{display:block;font-size:22rpx;color:#a38e71;margin-top:10rpx}.quick-fields{display:flex;justify-content:space-between;margin-top:20rpx}.quick-field{box-sizing:border-box;display:flex;align-items:center;width:31%;height:76rpx;padding:0 13rpx;border-radius:19rpx;background:rgba(255,255,255,.45);border:1rpx solid #ead9ad}.quick-field input{width:0;flex:1;min-width:0;font-size:27rpx}.quick-field>text{font-size:20rpx;margin:0 6rpx 0 3rpx;color:#9e896c}.quick-field image{width:25rpx;height:25rpx;flex:none;opacity:.55;pointer-events:none}.prefs-error{display:block;color:#b64c3d;font-size:22rpx;margin-top:16rpx;line-height:1.7}.display-row+.display-row{border-top:1rpx solid rgba(224,212,188,.45);margin-top:8rpx;padding-top:8rpx}.display-copy{flex:1;min-width:0}.display-copy>text{display:block;font-size:25rpx}.display-copy>text+text{font-size:21rpx;color:#a38f74;margin-top:8rpx}.display-row switch{transform:scale(.85);transform-origin:100% 50%;flex:none;margin-left:12rpx}.prefs-footer{display:block;text-align:center;color:#aa957a;font-size:21rpx;margin:24rpx 0}

.theme-choices{display:flex;flex-wrap:nowrap;gap:10rpx;margin-top:18rpx}.theme-choice{position:relative;box-sizing:border-box;flex:1;min-width:0;padding:8rpx;border:2rpx solid rgba(218,201,166,.6);border-radius:16rpx;background:rgba(255,255,255,.2)}.theme-selected{border-color:#dfb345;box-shadow:0 0 0 2rpx rgba(255,221,110,.15)}.theme-preview{height:78rpx;box-sizing:border-box;padding:8rpx;border-radius:10rpx;overflow:hidden}.preview-simple{background:#f7f1df}.preview-light{background:radial-gradient(ellipse at 100% 0%,#ffd35a,transparent 80%),#fff5d5}.preview-header{width:35%;height:9rpx;border-radius:5rpx;background:#ceae5e;margin-bottom:11rpx}.preview-tile{height:15rpx;border-radius:7rpx;margin-top:7rpx;border:1rpx solid #fff;background:#fffdfa}.preview-light .preview-tile{background:rgba(255,255,255,.25);border-color:rgba(255,255,255,.9)}.theme-name{display:flex;align-items:center;justify-content:center;margin-top:10rpx;font-size:22rpx;font-weight:600;white-space:nowrap}.theme-check{position:absolute;right:7rpx;top:7rpx;display:flex;align-items:center;justify-content:center;width:24rpx;height:24rpx;border-radius:50%;font-size:18rpx;color:#70501c;background:#ffe18a}.theme-check:empty{display:none}.theme-description{display:none}
@import "../../styles/surfaces.wxss";

.preview-dark{background:#171a21}.preview-dark .preview-tile{background:#2c3340;border-color:#4b5363}.preview-system{background:linear-gradient(90deg,#f7f1df 50%,#171a21 50%)}.preview-system .preview-tile{background:rgba(173,171,153,.2);border-color:#b5af9c}

.transparency-value{font-size:25rpx;color:#b38a2e}.transparency-labels{display:flex;justify-content:space-between;font-size:21rpx;color:#a78d6b}.nav-preview-scene{margin-top:22rpx;padding:18rpx 12rpx;border-radius:22rpx;background:linear-gradient(115deg,#f5dc85,#d3e1cc 48%,#dfb080);overflow:hidden}.nav-preview-glass{display:flex;justify-content:space-around;align-items:center;height:78rpx;border-radius:24rpx;border:1rpx solid rgba(255,255,255,.65);backdrop-filter:blur(16px) saturate(145%);-webkit-backdrop-filter:blur(16px) saturate(145%);font-size:24rpx;color:#765528}.ui-theme-dark .nav-preview-glass{color:#ffdc77}

.glass-toggle-row,.blur-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:24rpx;font-size:24rpx}.glass-toggle-row{padding-top:18rpx;border-top:1rpx solid rgba(150,130,90,.12)}.blur-heading{margin-top:30rpx}
