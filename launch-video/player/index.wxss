page{background:#edf0f4}.launch-video-page{position:fixed;inset:0;background:#edf0f4}.launch-video{width:100%;height:100%;background:#edf0f4}.launch-skip{position:absolute;right:28rpx;top:calc(100rpx + env(safe-area-inset-top));padding:14rpx 26rpx;border-radius:28rpx;background:rgba(45,45,45,.42);color:#fff;font-size:24rpx;line-height:1.5;text-align:center}.launch-play{position:absolute;bottom:calc(80rpx + env(safe-area-inset-bottom));left:25%;width:50%;padding:20rpx 0;border-radius:24rpx;background:rgba(45,45,45,.55);color:#fff;font-size:27rpx;text-align:center}
