page { min-height:100%; background:#fffbef; background-image:radial-gradient(ellipse at 100% 8%,rgba(255,224,95,.23),transparent 55%),radial-gradient(ellipse at 0% 95%,rgba(255,231,148,.2),transparent 60%); color:#432b1d; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif; }
/* 前台恢复重绘的临时类（见 utils/repaint.js）：只改一点点透明度，肉眼看不出来，
   但足以让 WebView 重新光栅化整页，修掉 Android 切后台回来整页空白。
   不要改成 transform/filter/will-change，那会改变 fixed 定位的包含块，底部导航会跳位。 */
.ui-repaint { opacity:.999; }
button { border-radius:24rpx; } button::after { border:none; }
/* 搭配卡：饮食建议页与食谱库共用（.recipe-* 前缀，勿在页面内重名） */
/* 搭配建议 */
.group-title {
    display: block;
    margin: 36rpx 0 4rpx 8rpx;
    color: #646a73;
    font-size: 25rpx;
    font-weight: 600;
    letter-spacing: 1rpx;
}

.recipe-card {
    margin-top: 16rpx;
    padding: 28rpx;
    border-radius: 28rpx;
    background: rgba(255, 255, 255, 0.68);
    backdrop-filter: blur(40rpx);
    -webkit-backdrop-filter: blur(40rpx);
    border: 2rpx solid rgba(255, 255, 255, 0.7);
    box-shadow: 0 14rpx 40rpx rgba(31, 35, 41, 0.06);
}

.recipe-top {
    display: flex;
    align-items: flex-start;
}

.recipe-icon {
    flex: 0 0 auto;
    width: 92rpx;
    height: 92rpx;
    border-radius: 50%;
    background: rgba(253, 236, 226, 0.9);
    border: 2rpx solid rgba(255, 255, 255, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48rpx;
    line-height: 1;
}

.recipe-main {
    flex: 1;
    min-width: 0;
    margin-left: 22rpx;
}

.recipe-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
}

.recipe-meal {
    margin-right: 10rpx;
    padding: 3rpx 12rpx;
    border-radius: 8rpx;
    background: rgba(230, 174, 26, 0.12);
    color: #c04a1c;
    font-size: 20rpx;
}

.recipe-tag {
    margin-right: 8rpx;
    padding: 3rpx 12rpx;
    border-radius: 8rpx;
    background: rgba(31, 35, 41, 0.05);
    color: #646a73;
    font-size: 20rpx;
}

.recipe-title {
    display: block;
    margin-top: 10rpx;
    color: #432b1d;
    font-size: 29rpx;
    font-weight: 600;
    line-height: 1.45;
}

.recipe-nutri {
    display: block;
    margin-top: 8rpx;
    color: #a76b11;
    font-size: 24rpx;
    font-weight: 600;
}

.recipe-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 20rpx;
    padding-top: 18rpx;
    border-top: 2rpx solid rgba(31, 35, 41, 0.06);
}

.recipe-why {
    flex: 1;
    min-width: 0;
    color: #8a8f99;
    font-size: 23rpx;
    line-height: 1.5;
}

.recipe-add {
    flex: 0 0 auto;
    margin-left: 20rpx;
    padding: 12rpx 30rpx;
    border-radius: 999rpx;
    background: linear-gradient(135deg, #ffd555, #a76b11);
    color: #ffffff;
    font-size: 24rpx;
    font-weight: 600;
    box-shadow: 0 6rpx 18rpx rgba(230, 174, 26, 0.28);
}

.recipe-over {
    display: block;
    margin-top: 12rpx;
    color: #d98324;
    font-size: 22rpx;
}

/* Shared removal controls: icon-only, with explicit accessible labels. */
.page .trash-action.trash-action{display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;flex:none;min-width:56rpx;width:56rpx;height:60rpx;min-height:60rpx;margin-left:0;padding:10rpx;border-radius:14rpx;line-height:1;background:transparent}.page .trash-action image{display:block;width:30rpx;height:34rpx;flex:none}.ui-theme-dark .trash-action image{filter:brightness(1.5)}.page .trash-action:active{background:rgba(188,114,82,.10)}.page .delete-pending.trash-action,.page .record-delete-active.trash-action,.page .entry-del-active.trash-action{background:rgba(196,106,83,.12)}
